From e0510970b07cde34bd45342c97f25f3bfffa5b57 Mon Sep 17 00:00:00 2001
From: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
Date: Tue, 13 Oct 2026 02:20:26 +0000
Subject: [PATCH 1/3] xe: Add missing PTL, ARL and RPL-S device IDs

xe_init() fails for any device ID that is not in the tables, which
leaves gralloc without a backend. Sync the tables with the IDs the
LTS2025 (6.18) xe driver binds (include/drm/intel/pciids.h):

 - PTL: 0xB084-0xB087
 - ARL: 0x7D41, 0x7D51, 0x7DD1, 0x7D67, 0xB640 (MTL graphics IP)
 - RPL-S: 0xA780-0xA783, 0xA788-0xA78B (Gen12)

Replaces minigbm-intel "Add RPL-S ID" and "Add support for PTL and
WCL to minigbm". WCL (0xFD80/0xFD81) is already present.

Tracked-On: NIACP3-1589
Signed-off-by: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
---
 intel_defines.h | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/intel_defines.h b/intel_defines.h
index e6cdaa7..94ed672 100644
--- a/intel_defines.h
+++ b/intel_defines.h
@@ -55,6 +55,7 @@ const uint16_t gen12_ids[] = {
 	0x46a0, 0x46a1, 0x46a2, 0x46a3, 0x46a6, 0x46a8, 0x46aa, 0x46b0, 0x46b1, 0x46b2,
 	0x46b3, 0x46c0, 0x46c1, 0x46c2, 0x46c3, 0x9A40, 0x9A49, 0x9A59, 0x9A60, 0x9A68,
 	0x9A70, 0x9A78, 0x9AC0, 0x9AC9, 0x9AD9, 0x9AF8, 0x4905, 0x4906, 0x4907, 0x4908,
+	0xA780, 0xA781, 0xA782, 0xA783, 0xA788, 0xA789, 0xA78A, 0xA78B,
 };
 
 const uint16_t adlp_ids[] = {
@@ -69,6 +70,8 @@ const uint16_t rplp_ids[] = {
 
 const uint16_t mtl_ids[] = {
 	0x7D40, 0x7D60, 0x7D45, 0x7D55, 0x7DD5,
+	/* ARL */
+	0x7D41, 0x7D51, 0x7DD1, 0x7D67, 0xB640,
 };
 
 const uint16_t lnl_ids[] = {
@@ -77,5 +80,5 @@ const uint16_t lnl_ids[] = {
 	0x64B0,
 };
 
-const uint16_t ptl_ids[] = { 0xB080, 0xB081, 0xB082, 0xB083, 0xB08F,
-			     0xB090, 0xB0A0, 0xB0B0, 0xFD80, 0xFD81 };
+const uint16_t ptl_ids[] = { 0xB080, 0xB081, 0xB082, 0xB083, 0xB084, 0xB085, 0xB086,
+			     0xB087, 0xB08F, 0xB090, 0xB0A0, 0xB0B0, 0xFD80, 0xFD81 };
