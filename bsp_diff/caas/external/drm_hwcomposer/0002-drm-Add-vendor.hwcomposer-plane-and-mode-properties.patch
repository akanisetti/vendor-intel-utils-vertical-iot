From ff982b6202228ed05010330e0beedeb9ec7b60a6 Mon Sep 17 00:00:00 2001
From: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
Date: Tue, 13 Oct 2026 02:39:18 +0000
Subject: [PATCH 2/6] drm: Add vendor.hwcomposer plane and mode properties

Port of the Intel drm-hwcomposer fork mode and plane controls used on
Celadon (fork commits 07b5f24 "Add some properties", baf74ea "Enable
multiple planes counter with property in HWC" and dbfa58b "Report more
modes with different refresh rates"):

 - vendor.hwcomposer.connector.id / vendor.hwcomposer.mode.id select
   the mode of one connector; vendor.hwcomposer.preferred.mode.limit
   (default 1) limits the others to their preferred mode. All refresh
   rates of the selected resolution are reported. Without
   vendor.hwcomposer.connector.id every mode is reported (unchanged).
 - vendor.hwcomposer.planes.enabling=0 restricts composition to the
   primary plane, vendor.hwcomposer.planes.num caps the planes per
   pipeline: primary, overlays and cursor together (defaults keep all
   planes).

The properties are read with android::base so the patch does not touch
utils/properties.cpp.

Tracked-On: NIACP3-1589
Signed-off-by: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
---
 drm/DrmConnector.cpp       | 58 ++++++++++++++++++++++++++++++++++++++
 drm/DrmDisplayPipeline.cpp | 44 ++++++++++++++++++++++++++++-
 2 files changed, 101 insertions(+), 1 deletion(-)

diff --git a/drm/DrmConnector.cpp b/drm/DrmConnector.cpp
index d116991..94ebe5e 100644
--- a/drm/DrmConnector.cpp
+++ b/drm/DrmConnector.cpp
@@ -16,6 +16,7 @@
 
 #include "DrmConnector.h"
 
+#include <android-base/properties.h>
 #include <drm/drm_mode.h>
 #include <xf86drmMode.h>
 
@@ -262,6 +263,61 @@ std::string DrmConnector::GetName() const {
   return "None";
 }
 
+namespace {
+/*
+ * Intel (Celadon) mode selection through vendor.hwcomposer.* properties:
+ *  - vendor.hwcomposer.connector.id: connector the selection is made for.
+ *    When unset (-1) all modes are reported on all connectors.
+ *  - vendor.hwcomposer.mode.id: 1-based index into the mode list of that
+ *    connector.
+ *  - vendor.hwcomposer.preferred.mode.limit (default 1): otherwise keep only
+ *    the preferred mode (the first mode if none is preferred).
+ * All refresh rates of the selected resolution are reported.
+ */
+void ApplyVendorModeSelection(uint32_t connector_id,
+                              const drmModeConnector &conn,
+                              std::vector<DrmMode> &modes) {
+  const int32_t target_connector = android::base::
+      GetIntProperty("vendor.hwcomposer.connector.id", -1);
+  if (target_connector == -1 || modes.empty() || conn.count_modes <= 0)
+    return;
+
+  const bool preferred_limit = android::base::
+      GetBoolProperty("vendor.hwcomposer.preferred.mode.limit", true);
+  int32_t mode_id = android::base::GetIntProperty("vendor.hwcomposer.mode.id",
+                                                  -1);
+  if (mode_id <= 0 || mode_id > conn.count_modes)
+    mode_id = -1;
+
+  // NOLINTBEGIN(cppcoreguidelines-pro-bounds-pointer-arithmetic)
+  const drmModeModeInfo *selected = nullptr;
+  if (connector_id == static_cast<uint32_t>(target_connector) &&
+      mode_id != -1) {
+    selected = &conn.modes[mode_id - 1];
+  } else if (preferred_limit) {
+    selected = &conn.modes[0];
+    for (int i = 0; i < conn.count_modes; ++i) {
+      if ((conn.modes[i].type & DRM_MODE_TYPE_PREFERRED) != 0) {
+        selected = &conn.modes[i];
+        break;
+      }
+    }
+  } else {
+    return;
+  }
+  // NOLINTEND(cppcoreguidelines-pro-bounds-pointer-arithmetic)
+
+  std::vector<DrmMode> selected_modes;
+  for (const DrmMode &mode : modes) {
+    if (mode.GetRawMode().hdisplay == selected->hdisplay &&
+        mode.GetRawMode().vdisplay == selected->vdisplay) {
+      selected_modes.push_back(mode);
+    }
+  }
+  modes.swap(selected_modes);
+}
+}  // namespace
+
 int DrmConnector::UpdateModes() {
   auto conn = MakeDrmModeConnectorUnique(*drm_->GetFd(), GetId());
   if (!conn) {
@@ -285,6 +341,8 @@ int DrmConnector::UpdateModes() {
     }
   }
 
+  ApplyVendorModeSelection(GetId(), *connector_, modes_);
+
   return 0;
 }
 
diff --git a/drm/DrmDisplayPipeline.cpp b/drm/DrmDisplayPipeline.cpp
index 1c5b7e1..d8022a2 100644
--- a/drm/DrmDisplayPipeline.cpp
+++ b/drm/DrmDisplayPipeline.cpp
@@ -16,6 +16,8 @@
 
 #include "DrmDisplayPipeline.h"
 
+#include <android-base/properties.h>
+
 #include "compositor/CompositionPlanner.h"
 #include "drm/DrmAtomicCommitSink.h"
 #include "drm/DrmConnector.h"
@@ -139,19 +141,57 @@ auto DrmDisplayPipeline::CreatePipeline(DrmConnector &connector)
   return {};
 }
 
+namespace {
+/*
+ * Intel (Celadon) plane limits through vendor.hwcomposer.* properties:
+ *  - vendor.hwcomposer.planes.enabling=0: use the primary plane only.
+ *  - vendor.hwcomposer.planes.num: maximum number of planes per pipeline,
+ *    including the primary plane.
+ */
+struct VendorPlaneLimits {
+  bool enabling;
+  int32_t max_planes;
+};
+
+auto GetVendorPlaneLimits() -> const VendorPlaneLimits & {
+  static const VendorPlaneLimits kLimits = [] {
+    constexpr int32_t kPlanesMaxNum = 99;
+    const int32_t num = android::base::
+        GetIntProperty("vendor.hwcomposer.planes.num", kPlanesMaxNum);
+    return VendorPlaneLimits{
+        .enabling = android::base::
+            GetBoolProperty("vendor.hwcomposer.planes.enabling", true),
+        .max_planes = num <= 0 ? kPlanesMaxNum : num,
+    };
+  }();
+  return kLimits;
+}
+}  // namespace
+
 auto DrmDisplayPipeline::GetUsablePlanes() const -> UsablePlanes {
   UsablePlanes pair;
   auto &[planes, cursor] = pair;
 
   planes.emplace_back(primary_plane);
 
+  const auto &limits = GetVendorPlaneLimits();
+  if (!limits.enabling)
+    return pair;
+
+  /* vendor.hwcomposer.planes.num caps all planes of the pipeline: the
+   * primary plane takes one slot, overlays and the cursor share the rest. */
+  int32_t planes_left = limits.max_planes - 1;
+
   for (const auto &plane : device->GetPlanes()) {
     if (plane->IsCrtcSupported(*crtc->Get())) {
       if (Properties::UseOverlayPlanes() &&
           plane->GetType() == DRM_PLANE_TYPE_OVERLAY) {
+        if (planes_left <= 0)
+          continue;
         auto op = plane->BindPipeline(this, true);
         if (op) {
           planes.emplace_back(op);
+          planes_left--;
         }
       } else if (plane->GetType() == DRM_PLANE_TYPE_CURSOR) {
         if (cursor) {
@@ -159,8 +199,10 @@ auto DrmDisplayPipeline::GetUsablePlanes() const -> UsablePlanes {
               "Encountered multiple cursor planes for CRTC %d. Ignoring "
               "plane %d",
               crtc->Get()->GetId(), plane->GetId());
-        } else {
+        } else if (planes_left > 0) {
           cursor = plane->BindPipeline(this, true);
+          if (cursor)
+            planes_left--;
         }
       }
     }
