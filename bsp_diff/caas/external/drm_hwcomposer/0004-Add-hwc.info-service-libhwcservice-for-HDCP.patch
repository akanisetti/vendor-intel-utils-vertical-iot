+#pragma once
+
+#include <stdint.h>
+
+/*
+ * Interface between the HWC and libhwcservicelib, the Intel hwc.info
+ * vndbinder service. The HWC dlopen()s HWC_SERVICE_LIB_PATH and passes the
+ * ops to StartHwcInfoService(), which runs the binder thread pool and does
+ * not return. libhwcservicelib does not link against the HWC sources.
+ *
+ * libhwcservicelib lives in vendor/intel/hardware/interfaces
+ * (graphic/hwcservice) and gets this header from libhwcservice_ops_headers.
+ */
+
+#define HWC_SERVICE_LIB_PATH "/vendor/lib64/hw/libhwcservicelib.so"
+#define HWC_SERVICE_START_FN "StartHwcInfoService"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* HDCP content type, same values as EHwcsContentType in libhwcservice. */
+enum HwcServiceHdcpContentType {
+  /* Any HDCP version: try HDCP 2.2+ (Type 1), fall back to HDCP 1.4. */
+  HWC_SERVICE_HDCP_CONTENT_TYPE0 = 0,
+  /* HDCP 2.2 or newer only: no fallback to HDCP 1.4. */
+  HWC_SERVICE_HDCP_CONTENT_TYPE1 = 1,
+};
+
+struct HwcServiceOps {
+  /* Passed back unchanged to the callbacks. The ops table and the service
+   * live for the whole process; the HWC resolves its current instance per
+   * call, so ctx does not point at a DrmHwc. */
+  void *ctx;
+  /* Start (enable) or stop HDCP on the display driven by the DRM connector,
+   * or on every display when all_displays is set. content_type is only used
+   * when enable is set. Returns false when no display supports the
+   * request. */
+  bool (*set_hdcp)(void *ctx, uint32_t connector, bool all_displays,
+                   bool enable, enum HwcServiceHdcpContentType content_type);
+};
+
+typedef void (*StartHwcInfoServiceFn)(const struct HwcServiceOps *ops);
+
+void StartHwcInfoService(const struct HwcServiceOps *ops);
+
+#ifdef __cplusplus
+}
+#endif
