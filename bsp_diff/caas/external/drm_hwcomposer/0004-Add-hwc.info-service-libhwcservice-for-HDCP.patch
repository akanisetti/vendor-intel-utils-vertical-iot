 }
 }  // namespace
 
+namespace {
+/*
+ * Intel hwc.info vndbinder service, optional. It is started once and lives as
+ * long as the process, while DrmHwc instances come and go (one per composer
+ * client). Calls go to the instance registered as owner; the owner pointer is
+ * only used under hwc_info_mutex, and ~DrmHwc() unregisters under the same
+ * mutex, so a call never reaches a destroyed instance.
+ * Lock order: hwc_info_mutex, then the ResourceManager main lock.
+ */
+std::mutex hwc_info_mutex;
+DrmHwc *hwc_info_owner = nullptr; /* guarded by hwc_info_mutex */
+
+bool HwcServiceSetHdcp(void * /*ctx*/, uint32_t connector, bool all_displays,
+                       bool enable, HwcServiceHdcpContentType content_type) {
+  const std::lock_guard lock(hwc_info_mutex);
+  if (hwc_info_owner == nullptr)
+    return false;
+  return hwc_info_owner->SetHdcp(connector, all_displays, enable,
+                                 content_type ==
+                                     HWC_SERVICE_HDCP_CONTENT_TYPE1);
+}
+
+void StartHwcInfoServiceOnce() {
+  static std::once_flag started;
+  std::call_once(started, [] {
+    std::thread([] {
+      void *handle = dlopen(HWC_SERVICE_LIB_PATH, RTLD_NOW);
+      if (handle == nullptr) {
+        ALOGI("%s not available: %s", HWC_SERVICE_LIB_PATH, dlerror());
+        return;
+      }
+      auto start = reinterpret_cast<StartHwcInfoServiceFn>(
+          dlsym(handle, HWC_SERVICE_START_FN));
+      if (start == nullptr) {
+        ALOGE("dlsym(%s) failed: %s", HWC_SERVICE_START_FN, dlerror());
+        return;
+      }
+      static const HwcServiceOps kOps = {
+          .ctx = nullptr, /* the owner is looked up per call */
+          .set_hdcp = HwcServiceSetHdcp,
+      };
+      start(&kOps);
+    }).detach();
+  });
+}
+}  // namespace
+
 DrmHwc::DrmHwc()
     : resource_manager_(this),
       dump_stats_tracker_(this),
       refresh_rates_reporter_(
-          DisplayRefreshRatesChangedAtomReporter::Create()) {};
+          DisplayRefreshRatesChangedAtomReporter::Create()) {
+  {
+    const std::lock_guard lock(hwc_info_mutex);
+    hwc_info_owner = this;
+  }
+  StartHwcInfoServiceOnce();
+};
+
+DrmHwc::~DrmHwc() {
+  /* Waits for an hwc.info call in flight; a newer instance stays the owner */
+  const std::lock_guard lock(hwc_info_mutex);
+  if (hwc_info_owner == this)
+    hwc_info_owner = nullptr;
+}
+
+bool DrmHwc::SetHdcp(uint32_t connector, bool all_displays, bool enable,
+                     bool type1_only) {
+  const std::unique_lock lock(GetResMan().GetMainLock());
+  bool done = false;
+  for (auto &[handle, display] : displays_) {
+    if (display->IsInHeadlessMode())
+      continue;
+    if (!all_displays && display->GetPipe().connector->Get()->GetId() != connector)
+      continue;
+    done |= enable ? display->StartHdcp(/*allow_type0_fallback=*/!type1_only)
+                   : display->StopHdcp();
+  }
+  return done;
+}
 
 /* Must be called after every display attach/detach cycle */
 void DrmHwc::FinalizeDisplayBinding() {
