   auto *crtc = pipe_->crtc->Get();
@@ -319,7 +440,12 @@ bool DrmAtomicStateManager::SetCtmIfNeeded(const AtomicCommitArgs &args,
   if (drm->GetResMan().UseColorPipeline()) {
