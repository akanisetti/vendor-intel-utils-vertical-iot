-  auto drm_color_matrix = ColorUtil::ToColorTransform3x3(args.color_matrix);
+  auto color_matrix = args.color_matrix;
+  if (color_adjustment_matrix_) {
+    color_matrix = std::make_shared<HalColorTransforMatrix>(
+        MultiplyHalMatrix(*args.color_matrix, *color_adjustment_matrix_));
+  }
+  auto drm_color_matrix = ColorUtil::ToColorTransform3x3(color_matrix);
   auto ctm_blob = drm->RegisterUserPropertyBlob(drm_color_matrix.get(),
                                                 sizeof(drm_color_ctm));
   if (!ctm_blob) {
@@ -335,6 +461,71 @@ bool DrmAtomicStateManager::SetCtmIfNeeded(const AtomicCommitArgs &args,
   return true;
 }
 
+void DrmAtomicStateManager::LoadColorAdjustmentIfNeeded(
+    const AtomicCommitArgs &args, AtomicRequest &request) {
+  if (!ColorAdjustmentEnabled())
+    return;
+
+  const bool power_on = args.power_mode &&
+                        *args.power_mode == HwcDisplay::PowerMode::kOn;
+  if (color_adjustment_loaded_ && !power_on)
+    return;
+  color_adjustment_loaded_ = true;
+
+  color_adjustment_matrix_.reset();
+  const auto hue = ReadColorValue("hue");
+  const auto saturation = ReadColorValue("saturation");
+  if (hue || saturation) {
+    double h = hue.value_or(0.0);
+    if (h < 0.0 || h > 359.0)
+      h = 0.0;
+    double s = saturation.value_or(100.0) / 100.0;
+    if (s < 0.75 || s > 1.25)
+      s = 1.0;
+    ALOGI("Color adjustment: hue %f saturation %f", h, s);
+    color_adjustment_matrix_ = HueSaturationMatrix(h, s);
+  }
+
+  /* Keep the previous LUT blob alive until this frame is retired */
+  if (color_adjustment_lut_blob_)
+    request.used_kms_objects.blobs.emplace_back(
+        std::move(color_adjustment_lut_blob_));
+
+  auto *crtc = pipe_->crtc->Get();
+  const auto lut_size = crtc->GetGammaLutSizeProperty().GetValue();
+  const auto brightness = ReadColorValue("brightness");
+  const auto contrast = ReadColorValue("contrast");
+  if ((!brightness && !contrast) || !crtc->GetGammaLutProperty() ||
+      !lut_size || *lut_size == 0) {
+    return;
+  }
+
+  double b = brightness.value_or(kNeutralColorValue);
+  if (b < 0.0 || b > 255.0)
+    b = kNeutralColorValue;
+  double c = contrast.value_or(kNeutralColorValue);
+  if (c < 0.0 || c > 255.0)
+    c = kNeutralColorValue;
+  ALOGI("Color adjustment: brightness %f contrast %f", b, c);
+
+  auto lut = BrightnessContrastLut(b, c, *lut_size);
+  color_adjustment_lut_blob_ = pipe_->device->RegisterUserPropertyBlob(
+      lut.data(), sizeof(drm_color_lut) * lut.size());
+  if (!color_adjustment_lut_blob_)
+    ALOGE("Failed to create color adjustment LUT blob");
+}
+
+bool DrmAtomicStateManager::SetColorAdjustmentLutIfNeeded(
+    AtomicRequest &request) {
+  auto *crtc = pipe_->crtc->Get();
+  if (!ColorAdjustmentEnabled() || !crtc->GetGammaLutProperty())
+    return true;
+
+  return crtc->GetGammaLutProperty()
+      .AtomicSet(*request.property_set,
+                 color_adjustment_lut_blob_ ? *color_adjustment_lut_blob_ : 0);
+}
+
 bool DrmAtomicStateManager::SetColorSpaceIfNeeded(const AtomicCommitArgs &args,
                                                   AtomicRequest &request) {
   auto *connector = pipe_->connector->Get();
@@ -554,11 +745,18 @@ DrmAtomicStateManager::GetAtomicModeReqForArgs(AtomicCommitArgs &args) {
     return nullptr;
   }
 
+  LoadColorAdjustmentIfNeeded(args, *atomic_request);
+
   if (!SetCtmIfNeeded(args, *atomic_request)) {
     ALOGE("Failed to set CTM blob");
     return nullptr;
   }
 
+  if (!SetColorAdjustmentLutIfNeeded(*atomic_request)) {
+    ALOGE("Failed to set color adjustment LUT");
+    return nullptr;
+  }
+
   if (!SetColorSpaceIfNeeded(args, *atomic_request)) {
     ALOGE("Failed to set color space");
     return nullptr;
