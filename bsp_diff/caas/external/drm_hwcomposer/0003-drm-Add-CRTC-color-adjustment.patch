+namespace {
+/*
+ * Intel (Celadon) display color adjustment, enabled with
+ * vendor.hwcomposer.color.adjustment.enabling=1. The values are read from
+ * /data/vendor/color/ when the display is powered on:
+ *  - hue (0..359 degrees), saturation (75..125 %): folded into the CRTC CTM
+ *    after the SurfaceFlinger color transform.
+ *  - brightness, contrast (0..255, 128 is neutral): CRTC GAMMA_LUT.
+ */
+constexpr char kColorAdjustmentDir[] = "/data/vendor/color/";
+constexpr double kNeutralColorValue = 128.0;
+
+auto ColorAdjustmentEnabled() -> bool {
+  static const bool kEnabled = android::base::
+      GetBoolProperty("vendor.hwcomposer.color.adjustment.enabling", false);
+  return kEnabled;
+}
+
+auto ReadColorValue(const char *name) -> std::optional<double> {
+  std::string value;
+  if (!android::base::ReadFileToString(std::string(kColorAdjustmentDir) + name,
+                                       &value)) {
+    return {};
+  }
+  char *end = nullptr;
+  const double result = std::strtod(value.c_str(), &end);
+  /* Reject "nan"/"inf": they would pass the range checks and reach the CTM or
+   * the float to uint16_t LUT conversion. */
+  if (end == value.c_str() || !std::isfinite(result))
+    return {};
+  return result;
+}
+
+using Mat3x3 = std::array<std::array<double, 3>, 3>;
+
+auto Multiply3x3(const Mat3x3 &a, const Mat3x3 &b) -> Mat3x3 {
+  Mat3x3 result{};
+  for (size_t y = 0; y < 3; y++) {
+    for (size_t x = 0; x < 3; x++) {
+      result[y][x] = (a[y][0] * b[0][x]) + (a[y][1] * b[1][x]) +
+                     (a[y][2] * b[2][x]);
+    }
+  }
+  return result;
+}
+
+/* Hue rotation and saturation scaling in BT.709 YCbCr space */
+auto HueSaturationMatrix(double hue, double saturation)
+    -> HalColorTransforMatrix {
+  const double hue_shift = hue * M_PI / 180.0;
+  const double c = std::cos(hue_shift);
+  const double s = std::sin(hue_shift);
+  const Mat3x3 hue_rotation = {{{1.0, 0.0, 0.0}, {0.0, c, -s}, {0.0, s, c}}};
+  const Mat3x3 saturation_scale = {
+      {{1.0, 0.0, 0.0}, {0.0, saturation, 0.0}, {0.0, 0.0, saturation}}};
+  const Mat3x3 ycbcr2rgb709 = {{{1.0000, 0.0000, 1.5748},
+                                {1.0000, -0.1873, -0.4681},
+                                {1.0000, 1.8556, 0.0000}}};
+  const Mat3x3 rgb2ycbcr709 = {{{0.2126, 0.7152, 0.0722},
+                                {-0.1146, -0.3854, 0.5000},
+                                {0.5000, -0.4542, -0.0458}}};
+  const Mat3x3 coeff = Multiply3x3(Multiply3x3(Multiply3x3(ycbcr2rgb709,
+                                                           saturation_scale),
+                                               hue_rotation),
+                                   rgb2ycbcr709);
+
+  /* The HAL matrix is applied to row vectors: hal[i * 4 + j] = coeff[j][i] */
+  HalColorTransforMatrix hal = kIdentityMatrix;
+  for (size_t i = 0; i < 3; i++) {
+    for (size_t j = 0; j < 3; j++) {
+      hal[(i * 4) + j] = static_cast<float>(coeff[j][i]);
+    }
+  }
+  return hal;
+}
+
+/* Returns a * b, i.e. the transform a followed by b */
+auto MultiplyHalMatrix(const HalColorTransforMatrix &a,
+                       const HalColorTransforMatrix &b)
+    -> HalColorTransforMatrix {
+  HalColorTransforMatrix result{};
+  for (size_t r = 0; r < 4; r++) {
+    for (size_t c = 0; c < 4; c++) {
+      float sum = 0.0F;
+      for (size_t k = 0; k < 4; k++)
+        sum += a[(r * 4) + k] * b[(k * 4) + c];
+      result[(r * 4) + c] = sum;
+    }
+  }
+  return result;
+}
+
+auto BrightnessContrastLut(double brightness_value, double contrast_value,
+                           size_t lut_size) -> std::vector<drm_color_lut> {
+  /* 128 is neutral for both: brightness 128 adds 0, contrast 128 scales by 1,
+   * so neutral values give an identity LUT. */
+  const double brightness = (brightness_value - kNeutralColorValue) / 255.0;
+  const double contrast = contrast_value / kNeutralColorValue;
+  const double last = lut_size > 1 ? static_cast<double>(lut_size - 1) : 1.0;
+  std::vector<drm_color_lut> lut(lut_size);
+  /* lut[0] stays black */
+  for (size_t i = 1; i < lut_size; i++) {
+    const double in = static_cast<double>(i) / last;
+    const double out = std::clamp(((in - 0.5) * contrast) + 0.5 + brightness,
+                                  0.0, 1.0);
+    const auto value = static_cast<uint16_t>(std::lround(out * 0xFFFF));
+    lut[i].red = value;
+    lut[i].green = value;
+    lut[i].blue = value;
+  }
+  return lut;
+}
+}  // namespace
