diff --git a/graphic/hwcservice/libhwcservice/test/hwcservice_test.cpp b/graphic/hwcservice/libhwcservice/test/hwcservice_test.cpp
new file mode 100644
index 0000000..8b40cd9
--- /dev/null
+++ b/graphic/hwcservice/libhwcservice/test/hwcservice_test.cpp
@@ -0,0 +1,151 @@
+/*
+ * Copyright (C) 2015 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include <binder/IServiceManager.h>
+#include <binder/ProcessState.h>
+#include <binder/TextOutput.h>
+#include <utils/String8.h>
+#include <cerrno>
+#include <cinttypes>
+#include <climits>
+#include <cstdlib>
+#include "hwcserviceapi.h"
+#include "iservice.h"
+
+using namespace android;
+using namespace hwcomposer;
+
+static void usage() {
+  aout << "Usage: hwcservice_test <option>\n"
+          "\t-h <connector> <type>: Enable HDCP on the display driven by DRM\n"
+          "\t                       connector <connector>.\n"
+          "\t-i <connector>:        Disable HDCP on that display.\n"
+          "\t-j <type>:             Enable HDCP on all displays.\n"
+          "\t-k:                    Disable HDCP on all displays.\n"
+          "\t<type>: 0 = Content Type 0 (any HDCP version, HDCP 1.4 fallback),\n"
+          "\t        1 = Content Type 1 (HDCP 2.2 or newer only).\n";
+  exit(-1);
+}
+
+static bool parse_uint(const char *arg, uint32_t *out) {
+  if (arg == nullptr || *arg == '\0')
+    return false;
+  char *end = nullptr;
+  errno = 0;
+  const unsigned long value = strtoul(arg, &end, 0);
+  if (errno != 0 || *end != '\0' || value > UINT32_MAX)
+    return false;
+  *out = static_cast<uint32_t>(value);
+  return true;
+}
+
+static bool parse_content_type(const char *arg, EHwcsContentType *out) {
+  uint32_t value = 0;
+  if (!parse_uint(arg, &value) || value > 1)
+    return false;
+  *out = value == 0 ? HWCS_CP_CONTENT_TYPE0 : HWCS_CP_CONTENT_TYPE1;
+  return true;
+}
+
+int main(int argc, char** argv) {
+  int action = 0;
+  int ch;
+
+  while ((ch = getopt(argc, argv, "hijk")) != -1) {
+    switch (ch) {
+      case 'h':
+      case 'i':
+      case 'j':
+      case 'k':
+        if (action != 0)
+          usage();  // one action per invocation
+        action = ch;
+        break;
+      default:
+        usage();
+    }
+  }
+  argc -= optind;
+  argv += optind;
+
+  // Validate the operands before connecting to the service.
+  uint32_t connector = 0;
+  EHwcsContentType content_type = HWCS_CP_CONTENT_TYPE0;
+  switch (action) {
+    case 'h':
+      if (argc != 2 || !parse_uint(argv[0], &connector) ||
+          !parse_content_type(argv[1], &content_type))
+        usage();
+      break;
+    case 'i':
+      if (argc != 1 || !parse_uint(argv[0], &connector))
+        usage();
+      break;
+    case 'j':
+      if (argc != 1 || !parse_content_type(argv[0], &content_type))
+        usage();
+      break;
+    case 'k':
+      if (argc != 0)
+        usage();
+      break;
+    default:
+      usage();
+  }
+
+#ifdef USE_PROCESS_STATE
+  // Initialize ProcessState with /dev/vndbinder as HwcService is
+  // in the vndbinder context
+  android::ProcessState::initWithDriver("/dev/vndbinder");
+#endif
+
+  // Connect to HWC service
+  HWCSHANDLE hwcs = HwcService_Connect();
+  if (hwcs == NULL) {
+    aout << "Could not connect to service\n";
+    return -1;
+  }
+
+  status_t ret = OK;
+  switch (action) {
+    case 'h':
+      aout << "Enabling HDCP (content type " << content_type
+           << ") for connector " << connector << endl;
+      ret = HwcService_Video_EnableHDCPSession_ForDisplay(hwcs, connector,
+                                                          content_type);
+      break;
+    case 'i':
+      aout << "Disabling HDCP for connector " << connector << endl;
+      ret = HwcService_Video_DisableHDCPSession_ForDisplay(hwcs, connector);
+      break;
+    case 'j':
+      aout << "Enabling HDCP (content type " << content_type
+           << ") for all displays" << endl;
+      ret = HwcService_Video_EnableHDCPSession_AllDisplays(hwcs, content_type);
+      break;
+    case 'k':
+      aout << "Disabling HDCP for all displays" << endl;
+      ret = HwcService_Video_DisableHDCPSession_AllDisplays(hwcs);
+      break;
+  }
+
+  HwcService_Disconnect(hwcs);
+  if (ret != OK) {
+    aout << "Request failed: " << ret << endl;
+    return -1;
+  }
+  return 0;
+}
