+// Client/server interface of the Intel hwc.info vndbinder service
+// (HDCP control), ported from the Intel drm-hwcomposer fork. The interfaces
+// are hand-written binder code, which Soong allows under vendor/ only.
+cc_library_shared {
+    name: "libhwcservice",
+    srcs: [
+        "icontrols.cpp",
+        "idiagnostic.cpp",
+        "iservice.cpp",
+        "hwcserviceapi.cpp",
+    ],
+    cflags: [
+        "-fvisibility=default",
