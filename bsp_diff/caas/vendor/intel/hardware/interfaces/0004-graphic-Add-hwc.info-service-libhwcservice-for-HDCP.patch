+namespace android {
+
+using namespace hwcomposer;
+
+class HwcService : public BnService {
+ public:
+  class Diagnostic : public BnDiagnostic {
+   public:
+    status_t ReadLogParcel(Parcel *parcel) override;
+    void EnableDisplay(uint32_t d) override;
+    void DisableDisplay(uint32_t d, bool bBlank) override;
+    void MaskLayer(uint32_t d, uint32_t layer, bool bHide) override;
+    void DumpFrames(uint32_t d, int32_t frames, bool bSync) override;
+  };
+
+  class Controls : public BnControls {
+   public:
+    explicit Controls(const HwcServiceOps &ops) : ops_(ops) {
+    }
+
+    status_t EnableHDCPSessionForDisplay(
+        uint32_t connector, EHwcsContentType content_type) override;
+    status_t EnableHDCPSessionForAllDisplays(
+        EHwcsContentType content_type) override;
+    status_t DisableHDCPSessionForDisplay(uint32_t connector) override;
+    status_t DisableHDCPSessionForAllDisplays() override;
+    status_t SetHDCPSRMForAllDisplays(const int8_t *SRM,
+                                      uint32_t SRMLength) override;
+    status_t SetHDCPSRMForDisplay(uint32_t connector, const int8_t *SRM,
+                                  uint32_t SRMLength) override;
+
+   private:
+    status_t SetHdcp(uint32_t connector, bool all_displays, bool enable,
+                     EHwcsContentType content_type);
+
+    const HwcServiceOps ops_;
+  };
+
+  explicit HwcService(const HwcServiceOps &ops) : ops_(ops) {
+  }
+
+  bool Start();
+
+  sp<IDiagnostic> GetDiagnostic() override;
+  sp<IControls> GetControls() override;
+  String8 GetHwcVersion() override;
+  void DumpOptions() override;
+  status_t SetOption(String8 option, String8 optionValue) override;
+  status_t EnableLogviewToLogcat(bool enable) override;
+
+ private:
+  const HwcServiceOps ops_;
+  std::mutex lock_;
+  sp<IDiagnostic> diagnostic_;
+};
+
+}  // namespace android
