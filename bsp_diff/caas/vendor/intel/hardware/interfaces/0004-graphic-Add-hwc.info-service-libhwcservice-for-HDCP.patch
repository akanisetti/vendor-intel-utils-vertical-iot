+
+#define LOG_TAG "hwc-info-service"
+
+#include "hwcservice.h"
+
+#include <binder/IPCThreadState.h>
+#include <binder/IServiceManager.h>
+#include <binder/ProcessState.h>
+#include <log/log.h>
+
+namespace android {
+
+bool HwcService::Start() {
+  const sp<IServiceManager> sm(defaultServiceManager());
+  if (sm == nullptr ||
+      sm->addService(String16(HWC_SERVICE_NAME), this, false) != OK) {
+    ALOGE("Failed to start %s service", HWC_SERVICE_NAME);
+    return false;
+  }
+  ALOGI("Started %s service", HWC_SERVICE_NAME);
+  return true;
+}
+
+String8 HwcService::GetHwcVersion() {
+  return String8("");
+}
+
+status_t HwcService::SetOption(String8 /*option*/, String8 /*optionValue*/) {
+  return OK;
+}
+
+void HwcService::DumpOptions() {
+}
+
+status_t HwcService::EnableLogviewToLogcat(bool /*enable*/) {
+  return OK;
+}
+
+sp<IDiagnostic> HwcService::GetDiagnostic() {
+  const std::lock_guard lock(lock_);
+  if (diagnostic_ == nullptr)
+    diagnostic_ = new Diagnostic();
+  return diagnostic_;
+}
+
+sp<IControls> HwcService::GetControls() {
+  return new Controls(ops_);
+}
+
+status_t HwcService::Diagnostic::ReadLogParcel(Parcel * /*parcel*/) {
+  return OK;
+}
+
+void HwcService::Diagnostic::EnableDisplay(uint32_t /*d*/) {
+}
+
+void HwcService::Diagnostic::DisableDisplay(uint32_t /*d*/, bool /*bBlank*/) {
+}
+
+void HwcService::Diagnostic::MaskLayer(uint32_t /*d*/, uint32_t /*layer*/,
+                                       bool /*bHide*/) {
+}
+
+void HwcService::Diagnostic::DumpFrames(uint32_t /*d*/, int32_t /*frames*/,
+                                        bool /*bSync*/) {
+}
+
+status_t HwcService::Controls::SetHdcp(uint32_t connector, bool all_displays,
+                                       bool enable,
+                                       EHwcsContentType content_type) {
+  if (ops_.set_hdcp == nullptr)
+    return INVALID_OPERATION;
+
+  HwcServiceHdcpContentType type;
+  switch (content_type) {
+    case HWCS_CP_CONTENT_TYPE0:
+      type = HWC_SERVICE_HDCP_CONTENT_TYPE0;
+      break;
+    case HWCS_CP_CONTENT_TYPE1:
+      type = HWC_SERVICE_HDCP_CONTENT_TYPE1;
+      break;
+    default:
+      ALOGE("Unknown HDCP content type %d", content_type);
+      return BAD_VALUE;
+  }
+
+  return ops_.set_hdcp(ops_.ctx, connector, all_displays, enable, type)
+             ? OK
+             : BAD_VALUE;
+}
+
+/*
+ * Type 0: the HWC tries HDCP 2.2+ first and falls back to HDCP 1.4.
+ * Type 1: HDCP 2.2+ only; the session fails instead of falling back.
+ */
+status_t HwcService::Controls::EnableHDCPSessionForDisplay(
+    uint32_t connector, EHwcsContentType content_type) {
+  return SetHdcp(connector, false, true, content_type);
+}
+
+status_t HwcService::Controls::EnableHDCPSessionForAllDisplays(
+    EHwcsContentType content_type) {
+  return SetHdcp(0, true, true, content_type);
+}
+
+status_t HwcService::Controls::DisableHDCPSessionForDisplay(
+    uint32_t connector) {
+  return SetHdcp(connector, false, false, HWCS_CP_CONTENT_TYPE0);
+}
+
+status_t HwcService::Controls::DisableHDCPSessionForAllDisplays() {
+  return SetHdcp(0, true, false, HWCS_CP_CONTENT_TYPE0);
+}
+
+/*
+ * SRM (System Renewability Message) programming is not implemented: the
+ * revocation list cannot be handed to the kernel, so report the request as
+ * unsupported instead of claiming success.
+ */
+status_t HwcService::Controls::SetHDCPSRMForAllDisplays(
+    const int8_t * /*SRM*/, uint32_t /*SRMLength*/) {
+  ALOGW("HDCP SRM update is not supported");
+  return INVALID_OPERATION;
+}
+
+status_t HwcService::Controls::SetHDCPSRMForDisplay(uint32_t /*connector*/,
+                                                    const int8_t * /*SRM*/,
+                                                    uint32_t /*SRMLength*/) {
+  ALOGW("HDCP SRM update is not supported");
+  return INVALID_OPERATION;
+}
+
+}  // namespace android
+
+void StartHwcInfoService(const struct HwcServiceOps *ops) {
+  if (ops == nullptr)
+    return;
+
+  const android::sp<android::HwcService> service = new android::HwcService(
+      *ops);
+  if (!service->Start())
+    return;
+
+  /* vendor libbinder: /dev/vndbinder */
+  android::ProcessState::self()->startThreadPool();
+  android::IPCThreadState::self()->joinThreadPool();
+}
