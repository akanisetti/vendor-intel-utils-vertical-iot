From 37cb6bff90a7396bf9209ba05c57954546460122 Mon Sep 17 00:00:00 2001
From: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
Date: Mon, 16 Nov 2026 08:50:30 +0000
Subject: [PATCH] Add memfd support

Signed-off-by: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
---
 .../android.hardware.media.c2-default-x86.policy            | 6 ++++++
 .../android.hardware.media.c2-default-x86_64.policy         | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/c2_store/seccomp_policy/android.hardware.media.c2-default-x86.policy b/c2_store/seccomp_policy/android.hardware.media.c2-default-x86.policy
index 8547727..c3621c0 100644
--- a/c2_store/seccomp_policy/android.hardware.media.c2-default-x86.policy
+++ b/c2_store/seccomp_policy/android.hardware.media.c2-default-x86.policy
@@ -65,6 +65,12 @@ ftruncate: 1
 ftruncate64: 1
 mkdirat: 1
 
+# Required when libcutils uses memfd (sys.use_memfd=true): fsetxattr() is
+# used to change the security context of the memfd and fcntl() is used to
+# set file seals on it (F_ADD_SEALS/F_GET_SEALS).
+fsetxattr: 1
+fcntl64: 1
+
 # Required by AddressSanitizer
 gettid: 1
 sched_yield: 1
diff --git a/c2_store/seccomp_policy/android.hardware.media.c2-default-x86_64.policy b/c2_store/seccomp_policy/android.hardware.media.c2-default-x86_64.policy
index e5581ee..9e627e5 100644
--- a/c2_store/seccomp_policy/android.hardware.media.c2-default-x86_64.policy
+++ b/c2_store/seccomp_policy/android.hardware.media.c2-default-x86_64.policy
@@ -65,6 +65,12 @@ ftruncate: 1
 ftruncate64: 1
 mkdirat: 1
 
+# Required when libcutils uses memfd (sys.use_memfd=true): fsetxattr() is
+# used to change the security context of the memfd and fcntl() is used to
+# set file seals on it (F_ADD_SEALS/F_GET_SEALS).
+fsetxattr: 1
+fcntl: 1
+
 # Required by AddressSanitizer
 gettid: 1
 sched_yield: 1
-- 
2.34.1

