From 426cfbbf62ae72b374581b9cf4f37f1ff093d77f Mon Sep 17 00:00:00 2001
From: Anisetti Avinash Krishna <anisetti.avinash.krishna@intel.com>
Date: Sat, 25 Apr 2026 02:42:01 +0000
Subject: [PATCH] Add prebuilt LocationControlTest privileged app

- Convert LocationControlTest from source build to prebuilt
  android_app_import module
- Add privapp-permissions allowlist XML for LOCATION_HARDWARE permission
  grant
- APK is platform-signed and lands in /system/priv-app/
- Privapp allowlist installed to system/etc/permissions/ to match APK
  partition
  (required for ro.control_privapp_permissions=enforce on user builds)

Tracked-On: NIACP3-1182
Signed-off-by: Anisetti Avinash Krishna <anisetti.avinash.krishna@intel.com>
---
 LocationControlTest/Android.bp                  |   6 ++++++
 LocationControlTest/LocationControlTest.apk     | Bin 0 -> 37352 bytes
 ...missions-com.android.locationcontroltest.xml |   6 ++++++
 3 files changed, 12 insertions(+)
 create mode 100644 LocationControlTest/Android.bp
 create mode 100644 LocationControlTest/LocationControlTest.apk
 create mode 100644 LocationControlTest/privapp-permissions-com.android.locationcontroltest.xml

diff --git a/LocationControlTest/Android.bp b/LocationControlTest/Android.bp
new file mode 100644
index 0000000..00d700d
--- /dev/null
+++ b/LocationControlTest/Android.bp
@@ -0,0 +1,6 @@
+android_app_import {
+    name: "LocationControlTestPrebuilt",
+    apk: "LocationControlTest.apk",
+    privileged: true,
+    certificate: "platform",
+}
diff --git a/LocationControlTest/LocationControlTest.apk b/LocationControlTest/LocationControlTest.apk
new file mode 100644
index 0000000000000000000000000000000000000000..b603c4c658f129e3339efabf5882d349ecf34335
GIT binary patch
