From 4fb2f55457c3e94940588af22df8d65c94accc45 Mon Sep 17 00:00:00 2001
From: "Suresh, Prashanth" <prashanth.suresh@intel.com>
Date: Wed, 21 Oct 2026 14:43:01 +0000
Subject: [PATCH] vpl-gpu-rt: Wire in 3 files new in 26.2.3 never added to
 Android.mk

A real flashfiles build failed to link libmfx-gen.so with 4 undefined
symbols:

- MFXVideoENCODE_CreateEncTools / MFXVideoENCODE_DestroyEncTools,
  defined in shared/enctools/src/mfx_enctools.cpp -- a file the
  26.2.3 upgrade (1669afcc) never added to Android.mk at all (only
  its include dir, shared/enctools/include, was already wired).

- HEVCEHW::Linux::Base_Next::MFXVideoENCODEH265_HW's constructor and
  AV1EHW::Linux::Base_Next::MFXVideoENCODEAV1_HW's constructor,
  defined in hevcehw_base_next_lin.cpp / av1ehw_base_next_lin.cpp --
  both brand new files added by the same upgrade commit (confirmed via
  git log --diff-filter=A), referenced by their codec's dispatcher
  (hevcehw_disp.cpp / av1ehw_disp.cpp) but never added to
  MFX_LOCAL_SRC_FILES_HW, even though their containing directories
  (encode_hw/{av1,hevc}/linux/base) were already correctly wired as
  include dirs.

Added all 3 to their natural locations: the two _next_lin.cpp files
alongside their codec's other linux/base/*.cpp entries, and
mfx_enctools.cpp as a new MFX_SHARED_FILES_HW += block (it lives under
shared/enctools/src/, not mfx_lib/shared/src/, so it falls outside
MFX_SHARED_FILES_IMPL's addprefix).

Tracked-On: NIACP3-1547
Signed-off-by: Suresh, Prashanth <prashanth.suresh@intel.com>
---
 _studio/mfx_lib/Android.mk | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/_studio/mfx_lib/Android.mk b/_studio/mfx_lib/Android.mk
index 5313508e..4f810f5c 100644
--- a/_studio/mfx_lib/Android.mk
+++ b/_studio/mfx_lib/Android.mk
@@ -54,6 +54,7 @@ MFX_LOCAL_SRC_FILES_HW += \
     mfx_lib/encode_hw/av1/linux/base/av1ehw_base_va_lin.cpp \
     mfx_lib/encode_hw/av1/linux/base/av1ehw_base_va_packer_lin.cpp \
     mfx_lib/encode_hw/av1/linux/base/av1ehw_base_max_frame_size_lin.cpp \
+    mfx_lib/encode_hw/av1/linux/base/av1ehw_base_next_lin.cpp \
     mfx_lib/encode_hw/av1/agnostic/Xe_HPM/av1ehw_xe_hpm_segmentation.cpp \
     mfx_lib/encode_hw/av1/linux/Xe_HPM/av1ehw_xe_hpm_lin.cpp \
     mfx_lib/encode_hw/av1/linux/Xe_LPM_plus/av1ehw_xe_lpm_plus_lin.cpp \
@@ -108,6 +109,7 @@ MFX_LOCAL_SRC_FILES_HW += \
     mfx_lib/encode_hw/hevc/agnostic/g12/hevcehw_g12_caps.cpp \
     mfx_lib/encode_hw/hevc/linux/base/hevcehw_base_interlace_lin.cpp \
     mfx_lib/encode_hw/hevc/linux/base/hevcehw_base_lin.cpp \
+    mfx_lib/encode_hw/hevc/linux/base/hevcehw_base_next_lin.cpp \
     mfx_lib/encode_hw/hevc/linux/base/hevcehw_base_dirty_rect_lin.cpp \
     mfx_lib/encode_hw/hevc/linux/base/hevcehw_base_max_frame_size_lin.cpp \
     mfx_lib/encode_hw/hevc/linux/base/hevcehw_base_enctools_qmatrix_lin.cpp \
@@ -243,6 +245,11 @@ MFX_SHARED_FILES_IMPL := $(addprefix mfx_lib/shared/src/, \
 MFX_SHARED_FILES_HW := \
     $(MFX_SHARED_FILES_IMPL)
 
+#enctools' CreateEncTools/DestroyEncTools implementation: not under
+#mfx_lib/shared/src/, which MFX_SHARED_FILES_IMPL's addprefix covers
+MFX_SHARED_FILES_HW += $(addprefix shared/enctools/src/, \
+    mfx_enctools.cpp)
+
 MFX_SHARED_FILES_HW += $(addprefix mfx_lib/ext/genx/asc/isa/, \
     genx_scd_gen12lp_isa.cpp)
 
-- 
