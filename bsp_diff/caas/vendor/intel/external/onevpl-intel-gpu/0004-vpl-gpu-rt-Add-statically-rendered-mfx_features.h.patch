+// NOTE: This file is normally generated by CMake's
+// configure_file(mfx_features.h.in -> mfx_features.h) using the MFX_ENABLE_*
+// option values in builder/BuildOptions.cmake. The Android.mk build has no
+// CMake-equivalent templating step, so this is a statically-rendered copy,
+// substituted to match BuildOptions.cmake's plain defaults (verified against
+// what Android.mk's _studio/mfx_lib/Android.mk already explicitly compiles:
+// every flag ON below has matching source wired into Android.mk, and every
+// flag left undefined below has no corresponding source wired in).
+
+#define MFX_ENABLE_EXT
+#define MFX_ENABLE_KERNELS
+/* #undef MFX_ENABLE_JPEG_SW_FALLBACK */
+#define MFX_ENABLE_MCTF
+#define MFX_ENABLE_ENCODE_MCTF
+#define MFX_ENABLE_ASC
+/* #undef MFX_ENABLE_CPLIB */
+
+#define MFX_ENABLE_VPP
+#define MFX_ENABLE_ENCTOOLS
+/* #undef MFX_ENABLE_AENC */
+/* #undef MFX_ENABLE_MVC_VIDEO_ENCODE */
+/* #undef MFX_ENABLE_SVC_VIDEO_ENCODE */
+
+#define MFX_ENABLE_H264_VIDEO_ENCODE
+#define MFX_ENABLE_H265_VIDEO_ENCODE
+#define MFX_ENABLE_AV1_VIDEO_ENCODE
+#define MFX_ENABLE_VP9_VIDEO_ENCODE
+#define MFX_ENABLE_VP8_VIDEO_DECODE
+#define MFX_ENABLE_VP9_VIDEO_DECODE
+#define MFX_ENABLE_H264_VIDEO_DECODE
+#define MFX_ENABLE_H265_VIDEO_DECODE
+#define MFX_ENABLE_MPEG2_VIDEO_DECODE
+#define MFX_ENABLE_MPEG2_VIDEO_ENCODE
+#define MFX_ENABLE_MJPEG_VIDEO_DECODE
+#define MFX_ENABLE_MJPEG_VIDEO_ENCODE
+#define MFX_ENABLE_VC1_VIDEO_DECODE
+#define MFX_ENABLE_AV1_VIDEO_DECODE
+#define MFX_ENABLE_VVC_VIDEO_DECODE
