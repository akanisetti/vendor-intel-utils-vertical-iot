From 002244a2d3b4dabade88973cc96e38f01ecf53da Mon Sep 17 00:00:00 2001
From: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
Date: Thu, 1 Oct 2026 06:59:38 +0000
Subject: [PATCH 1/3] Enable A17 build/boot on Wildcat Lake with LTS2025 kernel

changes:
- kernel/AndroidBoard.mk: switch CROSS_COMPILE to x86_64-linux-gnu- for
  kernel 6.18 triple check
- boot-arch/project-celadon: use marker-file for make_bootloader_dir to
  satisfy Siso outputs
- caas/BoardConfig.mk: drop noxsaves, reboot_panic, and legacy i915.*
  kernel cmdline entries
- caas/manifest.xml: bump sepolicy version from 202404 to 202604
  (target-level is bumped by bsp_diff/common/device/intel/mixins/0007)

Note: the cgroup v1 options (CONFIG_MEMCG_V1, CONFIG_CPUSETS_V1,
CONFIG_PROC_PID_CPUSET) required by the A17 framework are not changed
here; they are already enabled in
groups/kernel/gmin64/config-lts/linux-intel-lts2025/x86_64_defconfig by
device/intel/mixins commit a6b98727 ("A17 - Add 6.18 kernel support").

Tracked-On: NIACP3-1498
Signed-off-by: Anisetti Avinash Krishna <anisetti.avinash.krishna@intel.com>
Signed-off-by: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
---
 groups/boot-arch/project-celadon/AndroidBoard.mk | 11 +++++++++--
 groups/device-specific/caas/BoardConfig.mk       |  4 ----
 groups/device-specific/caas/manifest.xml         |  2 +-
 groups/kernel/AndroidBoard.mk                    |  2 +-
 4 files changed, 11 insertions(+), 8 deletions(-)

diff --git a/groups/boot-arch/project-celadon/AndroidBoard.mk b/groups/boot-arch/project-celadon/AndroidBoard.mk
index 5755a4e..2fd2364 100644
--- a/groups/boot-arch/project-celadon/AndroidBoard.mk
+++ b/groups/boot-arch/project-celadon/AndroidBoard.mk
@@ -321,10 +321,17 @@ $(PRODUCT_OUT)/vendor/firmware/kernelflinger.efi: $(PRODUCT_OUT)/efi/kernelfling
 	$(ACP) $(PRODUCT_OUT)/efi/kernelflinger.efi $@
 {{/fw_sbl}}
 
-make_bootloader_dir:
+.PHONY: make_bootloader_dir
+MAKE_BOOTLOADER_DIR_MARKER := $(PRODUCT_OUT)/.make_bootloader_dir_done
+
+$(MAKE_BOOTLOADER_DIR_MARKER):
 	@mkdir -p $(PRODUCT_OUT)/root/bootloader
+	@mkdir -p $(dir $@)
+	@touch $@
+
+make_bootloader_dir: $(MAKE_BOOTLOADER_DIR_MARKER)
 
-$(PRODUCT_OUT)/ramdisk.img: make_bootloader_dir
+$(PRODUCT_OUT)/ramdisk.img: $(MAKE_BOOTLOADER_DIR_MARKER)
 
 {{#bootloader_slot_ab}}
 esp_intermediates := $(call intermediates-dir-for,PACKAGING,esp_zip)
diff --git a/groups/device-specific/caas/BoardConfig.mk b/groups/device-specific/caas/BoardConfig.mk
index e633f15..1ec5142 100644
--- a/groups/device-specific/caas/BoardConfig.mk
+++ b/groups/device-specific/caas/BoardConfig.mk
@@ -2,11 +2,7 @@ DEVICE_PACKAGE_OVERLAYS += ${TARGET_DEVICE_DIR}/overlay
 
 BOARD_KERNEL_CMDLINE += \
 	no_timer_check \
-	noxsaves \
-	reboot_panic=p,w \
-	i915.hpd_sense_invert=0x7 \
 	intel_iommu=off \
-	i915.enable_pvmmio=0 \
 	loop.max_part=7
 
 BOARD_FLASHFILES += ${TARGET_DEVICE_DIR}/bldr_utils.img:bldr_utils.img
diff --git a/groups/device-specific/caas/manifest.xml b/groups/device-specific/caas/manifest.xml
index f6454b5..93c3f36 100644
--- a/groups/device-specific/caas/manifest.xml
+++ b/groups/device-specific/caas/manifest.xml
@@ -37,6 +37,6 @@
     </hal>
     <!--<kernel target-level="5"/>-->
     <sepolicy>
-        <version>202404</version>
+        <version>202604</version>
     </sepolicy>
 </manifest>
diff --git a/groups/kernel/AndroidBoard.mk b/groups/kernel/AndroidBoard.mk
index 4ea6ea1..bc92a9e 100644
--- a/groups/kernel/AndroidBoard.mk
+++ b/groups/kernel/AndroidBoard.mk
@@ -82,7 +82,7 @@ KERNEL_MAKE_OPTIONS = \
     O=$(abspath $(LOCAL_KERNEL_PATH)) \
     ARCH=$(TARGET_KERNEL_ARCH) \
     INSTALL_MOD_PATH=$(KERNEL_INSTALL_MOD_PATH) \
-    CROSS_COMPILE="x86_64-linux-androidkernel-" \
+    CROSS_COMPILE="x86_64-linux-gnu-" \
     CCACHE_SLOPPINESS=$(KERNEL_CCSLOP) \
     $(KERNEL_CLANG_TRIPLE) \
     $(KERNEL_CC)
-- 
