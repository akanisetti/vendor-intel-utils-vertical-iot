From f87c2f5a1bf86452df4dac75265279581958496e Mon Sep 17 00:00:00 2001
From: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
Date: Tue, 13 Oct 2026 02:27:52 +0000
Subject: [PATCH 85/86] device-specific/caas: Drop composer3 from device
 manifest

The HWC moved from vendor/intel/external/drm-hwcomposer to AOSP
external/drm_hwcomposer. AOSP's
android.hardware.composer.hwc3-service.drm installs its own VINTF
fragment (hwc3-drm.xml, composer3 v5), so the static composer3 v4
entry would duplicate the instance with a mismatched version.

Tracked-On: NIACP3-1589
Signed-off-by: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
---
 groups/device-specific/caas/manifest.xml | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/groups/device-specific/caas/manifest.xml b/groups/device-specific/caas/manifest.xml
index 93c3f36..543b931 100644
--- a/groups/device-specific/caas/manifest.xml
+++ b/groups/device-specific/caas/manifest.xml
@@ -9,14 +9,6 @@
         <version>1</version>
         <fqname>IHealth/default</fqname>
     </hal-->
-    <hal format="aidl">
-        <name>android.hardware.graphics.composer3</name>
-        <version>4</version>
-        <interface>
-            <name>IComposer</name>
-            <instance>default</instance>
-        </interface>
-    </hal>
     <!--hal format="aidl" optional="true">
         <name>android.hardware.bluetooth.audio</name>
         <version>2</version>
-- 
2.34.1

