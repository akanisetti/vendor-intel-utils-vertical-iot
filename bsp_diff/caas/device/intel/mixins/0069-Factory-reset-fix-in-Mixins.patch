From 41952bbe6398b57bf832ee727b141b004904011c Mon Sep 17 00:00:00 2001
From: gdonthu <gangadhar.donthu@intel.com>
Date: Mon, 6 Apr 2026 10:27:27 +0000
Subject: [PATCH] Factory reset fix in Mixins

Signed-off-by: gdonthu <gangadhar.donthu@intel.com>
Co-authored-by: Jadeja, Anshumansinh <anshumansinh.jadeja@intel.com>
Co-authored-by: Krishna, Anisetti Avinash <anisetti.avinash.krishna@intel.com>
---
 groups/tee/trusty/fstab      | 2 +-
 groups/tee/trusty/init.rc    | 2 ++
 groups/tee/trusty/ueventd.rc | 2 +-
 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/groups/tee/trusty/fstab b/groups/tee/trusty/fstab
index f95473ca..7baf0426 100644
--- a/groups/tee/trusty/fstab
+++ b/groups/tee/trusty/fstab
@@ -1 +1 @@
-/dev/block/by-name/teedata       /mnt/vendor/persist         ext4    discard,noatime,noauto_da_alloc,nosuid,nodev,data=ordered,user_xattr,barrier=1          wait,formattable
+/dev/block/by-name/teedata       /mnt/vendor/persist         ext4    discard,noatime,noauto_da_alloc,nosuid,nodev,data=ordered,user_xattr,barrier=1          wait,check,formattable
diff --git a/groups/tee/trusty/init.rc b/groups/tee/trusty/init.rc
index 19739ced..e2fe05cf 100644
--- a/groups/tee/trusty/init.rc
+++ b/groups/tee/trusty/init.rc
@@ -10,5 +10,7 @@ service keyboxd /vendor/bin/keybox_provisioning -d /dev/trusty-ipc-dev0 -p /dev/
     oneshot
 
 on post-fs
+    # Restore SELinux labels on teedata partition after formattable creates ext4
+    restorecon_recursive /mnt/vendor/persist
     wait_for_prop vendor.modules.trusty.ready true
     chmod 666 /dev/trusty-ipc-dev0
diff --git a/groups/tee/trusty/ueventd.rc b/groups/tee/trusty/ueventd.rc
index 27998810..cf2c813c 100644
--- a/groups/tee/trusty/ueventd.rc
+++ b/groups/tee/trusty/ueventd.rc
@@ -1,2 +1,2 @@
-/dev/block/p*/*/*/by-name/teedata      0660 system system
+/dev/block/p*/*/*/by-name/teedata      0660 root system
 /dev/trusty-ipc-dev0                   0666 root root
-- 
2.34.1

