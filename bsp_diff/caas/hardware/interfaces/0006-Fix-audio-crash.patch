From 9f89c050d0568161ced6474fa255b94cbda3d34c Mon Sep 17 00:00:00 2001
From: Anisetti Avinash Krishna <anisetti.avinash.krishna@intel.com>
Date: Mon, 3 Aug 2026 17:57:54 +0000
Subject: [PATCH] Fix audio crash

This patch adds changes to handle audio service carsh,
when no primary card found.

Tests Done:
USB playback and Record
Camera record

Tracked-On: OAM-124062
Signed-off-by: padmashree mandri <padmashree.mandri@intel.com>
---
 audio/aidl/default/alsa/StreamAlsaBase.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/audio/aidl/default/alsa/StreamAlsaBase.cpp b/audio/aidl/default/alsa/StreamAlsaBase.cpp
index 9316517c0b..d44d39ae50 100644
--- a/audio/aidl/default/alsa/StreamAlsaBase.cpp
+++ b/audio/aidl/default/alsa/StreamAlsaBase.cpp
@@ -119,6 +119,10 @@ ndk::ScopedAStatus StreamAlsaBase::setGain(float gain) {
                     device, const_cast<struct pcm_config*>(&mConfig.value()),
                     true /*require_exact_match*/);
         } else {
+	    if (device.card == -1) {
+		 LOG(ERROR) << __func__ << "No primary card found";
+		 return ::android::NO_INIT;
+	    } else
             proxy = alsa::openProxyForAttachedDevice(
                     device, const_cast<struct pcm_config*>(&mConfig.value()), mBufferSizeFrames);
         }
