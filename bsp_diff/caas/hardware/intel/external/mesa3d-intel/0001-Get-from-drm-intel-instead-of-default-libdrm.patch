From f19b063f2eeeaf54bad425d54f50b97958fe3ae6 Mon Sep 17 00:00:00 2001
From: lyintel <yang.a.lu@intel.com>
Date: Wed, 15 Jun 2022 10:23:58 +0000
Subject: [PATCH 01/19] Get from drm-intel instead of default libdrm

(cherry picked from commit 3836e93046613fc226a8046904b6c0a5d82ac881)
Tracked-On: NIACP3-1589
Signed-off-by: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
---
 android/Android.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/android/Android.mk b/android/Android.mk
index aaddb17a8a4e..8abf00081951 100644
--- a/android/Android.mk
+++ b/android/Android.mk
@@ -26,7 +26,7 @@ ifneq ($(filter true, $(BOARD_MESA3D_USES_MESON_BUILD)),)
 LOCAL_PATH := $(call my-dir)
 MESA3D_TOP := $(dir $(LOCAL_PATH))
 
-LIBDRM_VERSION = $(shell cat external/libdrm/meson.build | grep -o "\<version\>\s*:\s*'\w*\.\w*\.\w*'" | grep -o "\w*\.\w*\.\w*" | head -1)
+LIBDRM_VERSION = $(shell cat hardware/intel/external/drm-intel/meson.build | grep -o "\<version\>\s*:\s*'\w*\.\w*\.\w*'" | grep -o "\w*\.\w*\.\w*" | head -1)
 
 USE_LLVM_SWIFTSHADER := $(if $(wildcard external/llvm-project), false, \
     $(if $(wildcard external/swiftshader/third_party/llvm-[0-9]*), true, false))
