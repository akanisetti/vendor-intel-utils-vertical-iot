From fa2a33d7ba4e255476171c5fc83bb30555d82167 Mon Sep 17 00:00:00 2001
From: renchenglei <chenglei.ren@intel.com>
Date: Tue, 10 Aug 2021 17:00:18 +0800
Subject: [PATCH 14/19] virgl: Check height & width before create resource

We should confirm height & width valid before call
create_resource, otherwise virglrenderer driver will
run into error.

Tracked-On: OAM-97927
Signed-off-by: Ren Chenglei <chenglei.ren@intel.com>
(cherry picked from commit 75d1dea43ccfe149530d2231138122cb6bfb4df5)
Tracked-On: NIACP3-1589
Signed-off-by: Basanagouda Nagappa Koppad <basanagouda.nagappa.koppad@intel.com>
---
 src/gallium/winsys/virgl/drm/virgl_drm_winsys.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/gallium/winsys/virgl/drm/virgl_drm_winsys.c b/src/gallium/winsys/virgl/drm/virgl_drm_winsys.c
index f5bc94d6c429..45147c44f8a6 100644
--- a/src/gallium/winsys/virgl/drm/virgl_drm_winsys.c
+++ b/src/gallium/winsys/virgl/drm/virgl_drm_winsys.c
@@ -293,6 +293,11 @@ virgl_drm_winsys_resource_create(struct virgl_winsys *qws,
    createcmd.stride = stride;
    createcmd.size = size;
 
+   if ((createcmd.height == 0) || (createcmd.width == 0)) {
+      FREE(res);
+      return NULL;
+   }
+
    ret = drmIoctl(qdws->fd, DRM_IOCTL_VIRTGPU_RESOURCE_CREATE, &createcmd);
    if (ret != 0) {
       FREE(res);
-- 
