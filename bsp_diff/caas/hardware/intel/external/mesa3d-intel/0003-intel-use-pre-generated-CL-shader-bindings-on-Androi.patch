diff --git a/android/regen_intel_shaders.sh b/android/regen_intel_shaders.sh
new file mode 100755
index 000000000000..010c18b37caa
--- /dev/null
+++ b/android/regen_intel_shaders.sh
@@ -0,0 +1,49 @@
+#!/bin/bash
+# Copyright © 2026 Intel Corporation
+# SPDX-License-Identifier: MIT
+#
+# Regenerate the pre-built Intel OpenCL C shader bindings used by Android
+# platform builds (see with_intel_prebuilt_cl in meson.build):
+#
+#   src/intel/shaders/prebuilt/intel_gfx*_shaders_binding.{cpp,h}
+#   src/intel/blorp/prebuilt/blorp_shaders.{cpp,h}
+#
+# The bindings must match the Mesa sources exactly: run this after every Mesa
+# update and commit the result.
+#
+# Runs a native (Linux host) build with mesa_clc, which needs LLVM >= 15,
+# clang, libclc, LLVMSPIRVLib and SPIRV-Tools >= 2024.1 discoverable through
+# llvm-config and pkg-config. Extra meson arguments (e.g. a --native-file
+# pointing at a non-default llvm-config) can be passed via MESON_EXTRA_ARGS.
+
+set -euo pipefail
+
+MESA_TOP=$(cd "$(dirname "$0")/.." && pwd)
+BUILD_DIR=$(mktemp -d)
+trap 'rm -rf "$BUILD_DIR"' EXIT
+
+GENS="80 90 110 120 125 200 300"
+
+meson setup "$BUILD_DIR" "$MESA_TOP" --buildtype=release \
+	-Dplatforms= -Dgallium-drivers=iris -Dvulkan-drivers= \
+	-Dglx=disabled -Degl=disabled -Dgbm=disabled \
+	-Dllvm=enabled -Dmesa-clc=enabled -Dmesa-clc-bundle-headers=enabled \
+	-Dstatic-libclc=all -Dzstd=disabled -Dlibunwind=disabled \
+	-Dvalgrind=disabled -Dlmsensors=disabled -Dbuild-tests=false \
+	-Dtools= -Dvideo-codecs= ${MESON_EXTRA_ARGS:-}
+
+targets="src/intel/blorp/blorp_shaders.cpp src/intel/blorp/blorp_shaders.h"
+for gen in $GENS; do
+	targets+=" src/intel/shaders/intel_gfx${gen}_shaders_binding.cpp"
+	targets+=" src/intel/shaders/intel_gfx${gen}_shaders_binding.h"
+done
+# shellcheck disable=SC2086
+ninja -C "$BUILD_DIR" $targets
+
+for gen in $GENS; do
+	cp "$BUILD_DIR"/src/intel/shaders/intel_gfx${gen}_shaders_binding.{cpp,h} \
+		"$MESA_TOP"/src/intel/shaders/prebuilt/
+done
+cp "$BUILD_DIR"/src/intel/blorp/blorp_shaders.{cpp,h} "$MESA_TOP"/src/intel/blorp/prebuilt/
+
+echo "Regenerated Intel shader bindings for Mesa $(cat "$MESA_TOP"/VERSION)"
diff --git a/meson.build b/meson.build
index 7d4dca73627c..f16a35cafbf5 100644
--- a/meson.build
+++ b/meson.build
@@ -880,8 +880,16 @@ else
   with_drivers_clc = false
 endif
 
+# Android platform builds have no LLVM/libclc, so the Intel OpenCL C internal
+# shaders (src/intel/shaders, src/intel/blorp) are consumed as pre-generated
+# vtn_bindgen2 output from <dir>/prebuilt instead of being compiled with
+# mesa_clc. Regenerate them with android/regen_intel_shaders.sh on every Mesa
+# update.
+with_intel_prebuilt_cl = with_platform_android and get_option('mesa-clc') == 'auto'
+
 with_driver_using_cl = [
-  with_gallium_iris, with_gallium_crocus, with_intel_vk, with_intel_hasvk,
+  (with_gallium_iris or with_gallium_crocus or with_intel_vk or with_intel_hasvk) and
+    not with_intel_prebuilt_cl,
   with_gallium_asahi, with_asahi_vk, with_tools.contains('asahi'),
   with_gallium_panfrost, with_panfrost_vk,
   with_nouveau_vk, with_imagination_vk,
diff --git a/src/intel/blorp/meson.build b/src/intel/blorp/meson.build
index 1b82cc5ce1f1..457b8b8f5eeb 100644
--- a/src/intel/blorp/meson.build
+++ b/src/intel/blorp/meson.build
@@ -5,6 +5,9 @@ blorp_shader_files = files(
   'blorp_shaders.cl',
 )
 
+if with_intel_prebuilt_cl
+  blorp_shaders = files('prebuilt/blorp_shaders.cpp', 'prebuilt/blorp_shaders.h')
+else
 blorp_shaders_spv = custom_target(
   input : blorp_shader_files,
   output : 'blorp_shaders.spv',
@@ -26,10 +29,11 @@ blorp_shaders = custom_target(
   output : ['blorp_shaders.cpp', 'blorp_shaders.h'],
   command : [prog_vtn_bindgen2, blorp_shaders_spv, '@OUTPUT0@', '@OUTPUT1@'],
 )
+endif
 
 idep_blorp_shaders = declare_dependency(
   sources : [blorp_shaders],
-  include_directories : include_directories('.'),
+  include_directories : include_directories('.', with_intel_prebuilt_cl ? 'prebuilt' : '.'),
 )
 
 files_libblorp = files(
