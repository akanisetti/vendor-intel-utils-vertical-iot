+    0x0000000b, 0x00000028, 0x00000000, 0x00000000,
+    0x00000000, 0x00000002, 0x00002004, 0x00000300,
+    0x00000020, 0x00000000, 0x00002002, 0x00000280,
+    0x00000020, 0x00000000, 0x00000001, 0x00000000,
+    0x00000001, 0x00000000, 0x0000000a, 0xd0001ae4,
+    0xc8011ae4, 0x242e0000, 0x00000000, 0x00020003,
+    0x242e3200, 0x00000000, 0x00020003, 0x242e0480,
+    0x00000000, 0x00020003, 0x246a0000, 0x00000000,
+    0x00050006, 0x00000000, 0x00040007, 0x242e3680,
+    0x00000000, 0x00020003, 0x242a0000, 0x00000000,
+    0x00090008, 0x00000324, 0x00000028,
+};
+   nir_def *args[2] = { bounds_rect, pos };
+   return nir_call_serialized(b, impl_0_nir, sizeof(impl_0_nir), args);
+}
+
+#ifdef __cplusplus
+} /* extern C */
+#endif
+namespace {
+   struct vtn_bindgen_dummy {
+      vtn_bindgen_dummy() {
+         /* Format strings:
+          *
+          */
+const uint32_t printf_0_blob[1] = {
+    0x00000000,
+};
+         u_printf_singleton_init_or_ref();
+         u_printf_singleton_add_serialized((const void*)printf_0_blob, sizeof(printf_0_blob));
+      }
+
+      ~vtn_bindgen_dummy() {
+         u_printf_singleton_decref();
+      }
+   };
+
+   static vtn_bindgen_dummy vtn_bindgen_dummy_instance;
+}
