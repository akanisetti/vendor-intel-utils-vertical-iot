+nir_def *
+blorp_check_in_bounds(nir_builder *b, nir_def *bounds_rect, nir_def *pos)
+{
+   /*
+    block b0:  // preds:
+    32x4  %0 = @load_param (param_idx=0)
+    32x2  %1 = @load_param (param_idx=1)
+    1     %2 = uge %1.x, %0.x
+    1     %3 = ult %1.x, %0.y
+    1     %4 = uge %1.y, %0.z
