Bug: 433787201
---
 patchlevel/Android.bp                         | 21 +++++++++++++++++
 ...m.google.android.mainline.patchlevel.2.xml | 23 +++++++++++++++++++
 2 files changed, 44 insertions(+)
 create mode 100644 patchlevel/Android.bp
 create mode 100644 patchlevel/com.google.android.mainline.patchlevel.2.xml

diff --git a/patchlevel/Android.bp b/patchlevel/Android.bp
new file mode 100644
index 00000000..99d43233
--- /dev/null
+++ b/patchlevel/Android.bp
@@ -0,0 +1,21 @@
