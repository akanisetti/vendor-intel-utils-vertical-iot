diff --git a/services/inputflinger/dispatcher/InputDispatcher.cpp b/services/inputflinger/dispatcher/InputDispatcher.cpp
index 0d27a092de..f7dc6ec7fc 100644
--- a/services/inputflinger/dispatcher/InputDispatcher.cpp
+++ b/services/inputflinger/dispatcher/InputDispatcher.cpp
@@ -2160,14 +2160,20 @@ bool InputDispatcher::flushSensor(int deviceId, InputDeviceSensorType sensorType
             << ", sensorType=" << ftl::enum_string(sensorType).c_str();
     { // acquire lock
         std::scoped_lock _l(mLock);
-
-        for (auto it = mInboundQueue.begin(); it != mInboundQueue.end(); it++) {
-            std::shared_ptr<const EventEntry> entry = *it;
-            if (entry->type == EventEntry::Type::SENSOR) {
-                it = mInboundQueue.erase(it);
-                releaseInboundEventLocked(entry);
-            }
-        }
+        std::erase_if(mInboundQueue,
+                      [this, deviceId, sensorType](const std::shared_ptr<const EventEntry>& entry)
+                              REQUIRES(mLock) {
+                                  if (entry->type != EventEntry::Type::SENSOR) {
+                                      return false;
+                                  }
+                                  const auto& sensorEntry = static_cast<const SensorEntry&>(*entry);
+                                  if (sensorEntry.deviceId != deviceId ||
+                                      sensorEntry.sensorType != sensorType) {
+                                      return false;
+                                  }
+                                  releaseInboundEventLocked(entry);
+                                  return true;
+                              });
     }
     return true;
 }
diff --git a/services/inputflinger/tests/FakeInputDispatcherPolicy.cpp b/services/inputflinger/tests/FakeInputDispatcherPolicy.cpp
index 7949933269..e0b0723c77 100644
--- a/services/inputflinger/tests/FakeInputDispatcherPolicy.cpp
