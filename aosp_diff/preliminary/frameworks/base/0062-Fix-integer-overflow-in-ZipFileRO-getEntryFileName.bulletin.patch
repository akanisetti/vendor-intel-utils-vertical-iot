From 46e98295d82f24f7f61fe38040a29521b036e7ea Mon Sep 17 00:00:00 2001
From: Yurii Zubrytskyi <zyy@google.com>
Date: Wed, 22 Jul 2026 11:53:46 -0700
Subject: [PATCH] Fix integer overflow in ZipFileRO::getEntryFileName

zipEntry->name.length() + 1 was assigned to uint16_t, and that
overflows the max Zip entry length of 65535. The fix just uses
the size_t type.

Bug: 505748392
Test: atest libandroidfw_tests
Flag: EXEMPT BUGFIX
Change-Id: I1772a0c2bebde3d045730cba40ede9dc073cc69f
---
 libs/androidfw/Android.bp                    |  1 +
 libs/androidfw/ZipFileRO.cpp                 |  4 +-
 libs/androidfw/include/androidfw/ZipFileRO.h |  2 +
 libs/androidfw/tests/ZipFileRO_test.cpp      | 55 ++++++++++++++++++++
 4 files changed, 60 insertions(+), 2 deletions(-)
 create mode 100644 libs/androidfw/tests/ZipFileRO_test.cpp

diff --git a/libs/androidfw/Android.bp b/libs/androidfw/Android.bp
index 664ca38ccab4..32c0d0f5d8aa 100644
--- a/libs/androidfw/Android.bp
+++ b/libs/androidfw/Android.bp
@@ -249,6 +249,7 @@ cc_test {
         "tests/StringPool_test.cpp",
         "tests/Theme_test.cpp",
         "tests/TypeWrappers_test.cpp",
+        "tests/ZipFileRO_test.cpp",
         "tests/ZipUtils_test.cpp",
     ],
     static_libs: [
diff --git a/libs/androidfw/ZipFileRO.cpp b/libs/androidfw/ZipFileRO.cpp
index 10651cdaff33..9ed61c68d276 100644
--- a/libs/androidfw/ZipFileRO.cpp
+++ b/libs/androidfw/ZipFileRO.cpp
@@ -217,10 +217,10 @@ int ZipFileRO::getEntryFileName(ZipEntryRO entry, char* buffer, size_t bufLen)
     const
 {
     const _ZipEntryRO* zipEntry = reinterpret_cast<_ZipEntryRO*>(entry);
-    const uint16_t requiredSize = zipEntry->name.length() + 1;
+    const size_t requiredSize = zipEntry->name.length() + 1;
 
     if (bufLen < requiredSize) {
-        ALOGW("Buffer too short, requires %d bytes for entry name", requiredSize);
+        ALOGW("Buffer too short, requires %zu bytes for entry name", requiredSize);
         return requiredSize;
     }
 
diff --git a/libs/androidfw/include/androidfw/ZipFileRO.h b/libs/androidfw/include/androidfw/ZipFileRO.h
index 0f3f19c91ed1..181cdd97a87b 100644
--- a/libs/androidfw/include/androidfw/ZipFileRO.h
+++ b/libs/androidfw/include/androidfw/ZipFileRO.h
@@ -196,6 +196,8 @@ private:
     ZipFileRO(const ZipFileRO& src);
     ZipFileRO& operator=(const ZipFileRO& src);
 
+    friend class ZipFileROTest_GetEntryFileName_MaxLengthOverflow_Test;
+
     ZipFileRO(ZipArchiveHandle handle, char* fileName) : mHandle(handle),
         mFileName(fileName)
     {
diff --git a/libs/androidfw/tests/ZipFileRO_test.cpp b/libs/androidfw/tests/ZipFileRO_test.cpp
new file mode 100644
index 000000000000..f77c2ad5054a
--- /dev/null
+++ b/libs/androidfw/tests/ZipFileRO_test.cpp
@@ -0,0 +1,55 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "androidfw/ZipFileRO.h"
+
+#include <string>
+#include <string_view>
+#include <ziparchive/zip_archive.h>
+
+#include "gtest/gtest.h"
+
+namespace android {
+
+// This is a copy of a private internal struct defined in the .cpp file.
+struct _ZipEntryRO {
+    ZipEntry entry;
+    std::string_view name;
+};
+
+TEST(ZipFileROTest, GetEntryFileName_MaxLengthOverflow) {
+    constexpr size_t kMaxZipFileNameLen = 65535;
+    std::string long_filename(kMaxZipFileNameLen, 'a');
+
+    _ZipEntryRO dummy_entry{};
+    dummy_entry.name = long_filename;
+
+    ZipEntryRO entry = reinterpret_cast<ZipEntryRO>(&dummy_entry);
+
+    char buffer[4096] = {};
+    constexpr size_t buf_len = sizeof(buffer);
+
+    ZipFileRO zip_file(nullptr, nullptr);
+
+    int result = zip_file.getEntryFileName(entry, buffer, buf_len);
+
+    // Verify that requiredSize is 65536 and getEntryFileName returns 65536
+    // without getting any overflows or touching a buffer that's too small.
+    EXPECT_EQ(result, static_cast<int>(kMaxZipFileNameLen + 1));
+    EXPECT_EQ('\0', buffer[0]);
+}
+
+}  // namespace android
