From 9e084568ba3449efe5d1a2f7186ccf79866bfc18 Mon Sep 17 00:00:00 2001
From: Preston Cody <codeman@google.com>
Date: Sat, 13 Jun 2026 02:49:26 +0000
Subject: [PATCH] Fix heap use-after-free in NXP NFC HAL

A race condition exists in the NXP NFC HAL where a firmware download timeout can cause a heap buffer to be freed while the TML reader thread is still blocked on an I2C read. If a late frame arrives from the NFCC or an I2C interposer, the reader thread writes the data into the freed buffer, causing a heap use-after-free write.

This commit resolves the issue by explicitly setting `tReadInfo.pBuffer` to `NULL` in `phTmlNfc_ReadAbort()` to clear the dangling pointer. Additionally, null pointer checks are added to `phTmlNfc_TmlThread()` in the `pn8x`, `snxxx`, and `snxxx_v2` HAL implementations before any operations reliant on `pBuffer` (such as memory copies and packet logging). This ensures that any late responses received after a read abort are safely ignored.

Bug: 522376559
Test: built and atest locally
Flag: EXEMPT BUGFIX
This was autogenerated by MendIt (go/androidmendit)

Change-Id: Idd31809e5bfb88d4fa139927ae0ed36aaedcdfec
Merged-In: Idd31809e5bfb88d4fa139927ae0ed36aaedcdfec
(cherry picked from commit a0d57e70d8ca0c887dc7ace540e1afcafe516c2e)
---
 pn8x/halimpl/tml/phTmlNfc.cc     | 14 ++++++++++----
 snxxx/halimpl/tml/phTmlNfc.cc    | 14 ++++++++++----
 snxxx/halimpl_v2/tml/phTmlNfc.cc |  1 +
 3 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/pn8x/halimpl/tml/phTmlNfc.cc b/pn8x/halimpl/tml/phTmlNfc.cc
index 72b366e..5f879b0 100644
--- a/pn8x/halimpl/tml/phTmlNfc.cc
+++ b/pn8x/halimpl/tml/phTmlNfc.cc
@@ -349,13 +349,16 @@ static void* phTmlNfc_TmlThread(void* pParam) {
           sem_post(&gpphTmlNfc_Context->rxSemaphore);
         } else {
           pthread_mutex_lock(&gpphTmlNfc_Context->readInfoUpdateMutex);
-          memcpy(gpphTmlNfc_Context->tReadInfo.pBuffer, temp, dwNoBytesWrRd);
+          if (gpphTmlNfc_Context->tReadInfo.pBuffer != NULL) {
+            memcpy(gpphTmlNfc_Context->tReadInfo.pBuffer, temp, dwNoBytesWrRd);
+          }
           readRetryDelay = 0;
 
           NXPLOG_TML_D("PN54X - I2C Read successful.....\n");
           /* This has to be reset only after a successful read */
           gpphTmlNfc_Context->tReadInfo.bEnable = 0;
           if ((phTmlNfc_e_EnableRetrans == gpphTmlNfc_Context->eConfig) &&
+              (gpphTmlNfc_Context->tReadInfo.pBuffer != NULL) &&
               (0x00 != (gpphTmlNfc_Context->tReadInfo.pBuffer[0] & 0xE0))) {
             NXPLOG_TML_D("PN54X - Retransmission timer stopped.....\n");
             /* Stop Timer to prevent Retransmission */
@@ -373,9 +376,11 @@ static void* phTmlNfc_TmlThread(void* pParam) {
           }
           /* Update the actual number of bytes read including header */
           gpphTmlNfc_Context->tReadInfo.wLength = (uint16_t)(dwNoBytesWrRd);
-          phNxpNciHal_print_packet("RECV",
-                                   gpphTmlNfc_Context->tReadInfo.pBuffer,
-                                   gpphTmlNfc_Context->tReadInfo.wLength);
+          if (gpphTmlNfc_Context->tReadInfo.pBuffer != NULL) {
+            phNxpNciHal_print_packet("RECV",
+                                     gpphTmlNfc_Context->tReadInfo.pBuffer,
+                                     gpphTmlNfc_Context->tReadInfo.wLength);
+          }
 
           dwNoBytesWrRd = PH_TMLNFC_RESET_VALUE;
 
@@ -813,6 +818,7 @@ NFCSTATUS phTmlNfc_ReadAbort(void) {
 
   /*Reset the flag to accept another Read Request */
   gpphTmlNfc_Context->tReadInfo.bThreadBusy = false;
+  gpphTmlNfc_Context->tReadInfo.pBuffer = NULL;
   wStatus = NFCSTATUS_SUCCESS;
 
   return wStatus;
diff --git a/snxxx/halimpl/tml/phTmlNfc.cc b/snxxx/halimpl/tml/phTmlNfc.cc
index dbdec87..04f117f 100644
--- a/snxxx/halimpl/tml/phTmlNfc.cc
+++ b/snxxx/halimpl/tml/phTmlNfc.cc
@@ -347,13 +347,16 @@ static void* phTmlNfc_TmlThread(void* pParam) {
           readRetryDelay = 0;
           sem_post(&gpphTmlNfc_Context->rxSemaphore);
         } else {
-          memcpy(gpphTmlNfc_Context->tReadInfo.pBuffer, temp, dwNoBytesWrRd);
+          if (gpphTmlNfc_Context->tReadInfo.pBuffer != NULL) {
+            memcpy(gpphTmlNfc_Context->tReadInfo.pBuffer, temp, dwNoBytesWrRd);
+          }
           readRetryDelay = 0;
 
           NXPLOG_TML_D("NFCC - Read successful.....\n");
           /* This has to be reset only after a successful read */
           gpphTmlNfc_Context->tReadInfo.bEnable = 0;
           if ((phTmlNfc_e_EnableRetrans == gpphTmlNfc_Context->eConfig) &&
+              (gpphTmlNfc_Context->tReadInfo.pBuffer != NULL) &&
               (0x00 != (gpphTmlNfc_Context->tReadInfo.pBuffer[0] & 0xE0))) {
             NXPLOG_TML_D("NFCC - Retransmission timer stopped.....\n");
             /* Stop Timer to prevent Retransmission */
@@ -367,9 +370,11 @@ static void* phTmlNfc_TmlThread(void* pParam) {
           }
           /* Update the actual number of bytes read including header */
           gpphTmlNfc_Context->tReadInfo.wLength = (uint16_t)(dwNoBytesWrRd);
-          phNxpNciHal_print_packet("RECV",
-                                   gpphTmlNfc_Context->tReadInfo.pBuffer,
-                                   gpphTmlNfc_Context->tReadInfo.wLength);
+          if (gpphTmlNfc_Context->tReadInfo.pBuffer != NULL) {
+            phNxpNciHal_print_packet("RECV",
+                                     gpphTmlNfc_Context->tReadInfo.pBuffer,
+                                     gpphTmlNfc_Context->tReadInfo.wLength);
+          }
 
           dwNoBytesWrRd = PH_TMLNFC_RESET_VALUE;
 
@@ -794,6 +799,7 @@ NFCSTATUS phTmlNfc_ReadAbort(void) {
 
   /*Reset the flag to accept another Read Request */
   gpphTmlNfc_Context->tReadInfo.bThreadBusy = false;
+  gpphTmlNfc_Context->tReadInfo.pBuffer = NULL;
   wStatus = NFCSTATUS_SUCCESS;
 
   return wStatus;
diff --git a/snxxx/halimpl_v2/tml/phTmlNfc.cc b/snxxx/halimpl_v2/tml/phTmlNfc.cc
index fbf4ec0..97380a0 100644
