From 5727f605d44162b09f0e2fe92e273818637146cc Mon Sep 17 00:00:00 2001
From: Preston Cody <codeman@google.com>
Date: Sun, 14 Jun 2026 05:53:41 +0000
Subject: [PATCH] Fix AID routing precedence to prioritize default wallet
 services

A logic flaw in NFC'RegisteredAidCache conflict resolution allows a sideloaded application to squat on a shared role priority package name. This grants the attacker's app wallet-tier precedence, enabling it to intercept payment APDUs intended for the legitimate wallet application.

This commit resolves the issue in `RegisteredAidCache` by fixing two areas where AID routing precedence was incorrectly resolved:
1. When sorting multiple wallet services with the same AID type, the sort logic is updated to first prioritize the default wallet holder's own services over associated services, before falling back to alphabetical sorting by component name. This prevents an associated service from gaining priority merely by having an alphabetically earlier name.
2. When resolving prefix conflicts against exact-match child AIDs, the logic now explicitly checks if any of the conflicting services are owned by the default wallet holder itself (`conflictingHasWallet`). If so, it returns an empty resolve info to correctly allow the exact child AID rule to govern, rather than ignoring it in favor of the prefix.

Bug: 522373825
Test: atest NfcNciUnitTests:RegisteredAidCacheTest
Flag: EXEMPT BUGFIX

Change-Id: I6d0580c1df7514c878fe398f6a9fd0549756b3b9
(cherry picked from commit a810afd69488a55248e17e1ef94c9dc9d9c11608)
---
 .../nfc/cardemulation/RegisteredAidCache.java |  36 +++-
 .../cardemulation/RegisteredAidCacheTest.java | 170 ++++++++++++++++++
 2 files changed, 197 insertions(+), 9 deletions(-)

diff --git a/NfcNci/src/com/android/nfc/cardemulation/RegisteredAidCache.java b/NfcNci/src/com/android/nfc/cardemulation/RegisteredAidCache.java
index 8eb6d644f..ce9f600e2 100644
--- a/NfcNci/src/com/android/nfc/cardemulation/RegisteredAidCache.java
+++ b/NfcNci/src/com/android/nfc/cardemulation/RegisteredAidCache.java
@@ -561,11 +561,19 @@ public class RegisteredAidCache {
                         + mDefaultWalletHolderPackageName);
             }
             // If the role holder has multiple services with the same AID type, then we select
-            // the first one. The services are sorted alphabetically based on their component
-            // names.
-            defaultWalletServices.sort((o1, o2) ->
-                    String.CASE_INSENSITIVE_ORDER.compare(o1.getComponent().toShortString(),
-                            o2.getComponent().toShortString()));
+            // the first one. The services are sorted to prioritize the default wallet holder's
+            // own services over associated services, and then alphabetically based on their
+            // component names.
+            defaultWalletServices.sort((o1, o2) -> {
+                boolean o1IsWallet = o1.getComponent().getPackageName()
+                        .equals(mDefaultWalletHolderPackageName);
+                boolean o2IsWallet = o2.getComponent().getPackageName()
+                        .equals(mDefaultWalletHolderPackageName);
+                if (o1IsWallet && !o2IsWallet) return -1;
+                if (!o1IsWallet && o2IsWallet) return 1;
+                return String.CASE_INSENSITIVE_ORDER.compare(o1.getComponent().toShortString(),
+                        o2.getComponent().toShortString());
+            });
             resolveInfo.defaultService = defaultWalletServices.get(0);
         } else if (matchedPayment != null) {
             // 3d priority: if there is a preferred payment service,
@@ -675,12 +683,22 @@ public class RegisteredAidCache {
              return resolveinfo;
         } else if (mWalletRoleObserver.isWalletRoleFeatureEnabled()) {
             if (!aidDefaultInfo.walletDefaults.isEmpty()) {
-                // Check if any of the conflicting services is foreground default
-                if (conflictingDefaultInfo.foregroundDefault != null) {
-                    // Conflicting AID registration is in foreground, trumps prefix tap&pay default
+                boolean conflictingHasWallet = false;
+                for (ServiceAidInfo sai : conflictingDefaultInfo.walletDefaults) {
+                    if (sai.service.getComponent().getPackageName()
+                            .equals(mDefaultWalletHolderPackageName) && isExact(sai.aid)) {
+                        conflictingHasWallet = true;
+                        break;
+                    }
+                }
+                // Check if any of the conflicting services is foreground default or wallet holder
+                if (conflictingDefaultInfo.foregroundDefault != null || conflictingHasWallet) {
+                    // Conflicting AID registration is in foreground or wallet itself,
+                    // trumps prefix tap&pay default
                     if (VDBG) {
                         Log.d(TAG, "resolveAidConflictLocked: One of the conflicting AID "
-                                + "registrations is foreground preferred, ignoring prefix");
+                                + "registrations is foreground preferred or wallet holder, "
+                                + "ignoring prefix");
                     }
                     return EMPTY_RESOLVE_INFO;
                 } else {
diff --git a/NfcNci/tests/unit/src/com/android/nfc/cardemulation/RegisteredAidCacheTest.java b/NfcNci/tests/unit/src/com/android/nfc/cardemulation/RegisteredAidCacheTest.java
