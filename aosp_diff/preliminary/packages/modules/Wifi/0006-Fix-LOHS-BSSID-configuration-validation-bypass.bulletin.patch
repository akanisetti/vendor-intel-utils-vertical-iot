     private void sendSoftApCallbackStartFailure(@Nullable ISoftApCallback callback,
@@ -2298,7 +2305,8 @@ public class WifiServiceImpl extends IWifiManager.Stub {
      * proper permissions beyond the NetworkStack permission.
