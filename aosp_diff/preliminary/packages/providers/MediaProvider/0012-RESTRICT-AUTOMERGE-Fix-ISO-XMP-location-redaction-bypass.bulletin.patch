From 76a189311b2c178146704933a03c0042aabf3dee Mon Sep 17 00:00:00 2001
From: Mohit kumar <imohit@google.com>
Date: Tue, 17 Mar 2026 15:00:01 +0000
Subject: [PATCH] RESTRICT AUTOMERGE Fix ISO XMP location redaction bypass

MediaProvider previously failed to redact location data when it was
stored as attributes within an 'XMP_' box in ISO media files. This
allowed applications without the ACCESS_MEDIA_LOCATION permission to
bypass privacy controls.

This change fixes two primary flaws: 1. Container Parsing: IsoInterface
now properly identifies and extracts
   the 'XMP_' box (BOX_XMP), which was previously ignored during the
   box-flattening pass.
2. Attribute-based Redaction: XmpDataParser now scans both XML tag names
   and their associated attributes for sensitive EXIF fields. If a
   sensitive field (like GPSLatitude) is found as an attribute, the specific
   XML tag containing it is correctly targeted for redaction.

Bug: 470260357
Test: atest XmpDataParserTest
Test: Manually verified with provided PoC and gps_test_xmp.mp4
Flag: EXEMPT BUGFIX
Change-Id: I3a480dcfaed61b8793cebe5e5546cecc870b8e28
---
 .../providers/media/util/IsoInterface.java    |   3 +--
 .../providers/media/util/XmpDataParser.java   |  25 +++++++++++++++---
 tests/res/raw/gps_test_xmp.mp4                | Bin 0 -> 3253629 bytes
 .../media/util/XmpDataParserTest.java         |  12 +++++++++
 4 files changed, 34 insertions(+), 6 deletions(-)
 create mode 100644 tests/res/raw/gps_test_xmp.mp4

diff --git a/src/com/android/providers/media/util/IsoInterface.java b/src/com/android/providers/media/util/IsoInterface.java
index 43a00f00c..235a186a0 100644
--- a/src/com/android/providers/media/util/IsoInterface.java
+++ b/src/com/android/providers/media/util/IsoInterface.java
@@ -32,12 +32,10 @@ import java.io.FileDescriptor;
 import java.io.FileInputStream;
 import java.io.IOException;
 import java.nio.ByteOrder;
-import java.util.ArrayDeque;
 import java.util.ArrayList;
 import java.util.List;
 import java.util.Locale;
 import java.util.Objects;
-import java.util.Queue;
 import java.util.UUID;
 
 /**
@@ -230,6 +228,7 @@ public class IsoInterface {
             case BOX_META:
             case BOX_HDLR:
             case BOX_XYZ:
+            case BOX_XMP:
             case BOX_LOCI:
             case BOX_GPS:
             case BOX_GPS0:
diff --git a/src/com/android/providers/media/util/XmpDataParser.java b/src/com/android/providers/media/util/XmpDataParser.java
index cbd4bcf59..3e48d1d91 100644
--- a/src/com/android/providers/media/util/XmpDataParser.java
+++ b/src/com/android/providers/media/util/XmpDataParser.java
@@ -136,8 +136,9 @@ public final class XmpDataParser implements Closeable {
             } else if (NS_XMPMM.equals(ns)
                     && NAME_ORIGINAL_DOCUMENT_ID.equals(name)) {
                 builder.originalDocumentId(mParser.nextText());
-            } else if (NS_EXIF.equals(ns) && RedactionUtils.getsRedactedExifTags()
-                    .contains(name)) {
+            }
+
+            if (isSensitiveTagOrAttribute()) {
                 long start = offset;
                 do {
                     type = mParser.next();
@@ -194,8 +195,8 @@ public final class XmpDataParser implements Closeable {
             // attributes or tags, so we're willing to look for both
             final String ns = mParser.getNamespace();
             final String name = mParser.getName();
-            if (NS_EXIF.equals(ns) && RedactionUtils.getsRedactedExifTags()
-                    .contains(name)) {
+
+            if (isSensitiveTagOrAttribute()) {
                 long start = offset;
                 do {
                     type = mParser.next();
@@ -210,6 +211,22 @@ public final class XmpDataParser implements Closeable {
         return redactedRanges;
     }
 
+    private boolean isSensitiveTagOrAttribute() {
+        if (NS_EXIF.equals(mParser.getNamespace()) && RedactionUtils.getsRedactedExifTags()
+                .contains(mParser.getName())) {
+            return true;
+        }
+        for (int i = 0; i < mParser.getAttributeCount(); i++) {
+            final String attrNs = mParser.getAttributeNamespace(i);
+            final String attrName = mParser.getAttributeName(i);
+            if (NS_EXIF.equals(attrNs)
+                    && RedactionUtils.getsRedactedExifTags().contains(attrName)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
     private static class XmpData {
         @NonNull
         private final byte[] mRawXmp;
