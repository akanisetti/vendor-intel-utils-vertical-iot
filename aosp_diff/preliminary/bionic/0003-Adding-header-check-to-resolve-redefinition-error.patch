From 9ab5e00868c8d652027b26b40c6678406e40ab51 Mon Sep 17 00:00:00 2001
From: Salini Venate <salini.venate@intel.com>
Date: Fri, 7 Feb 2025 10:38:34 +0000
Subject: [PATCH] Adding header check to resolve redefinition error

Tests Done: Build and boot

Tracked-On: NA
Signed-off-by: Salini Venate <salini.venate@intel.com>
---
 libc/include/bits/mbstate_t.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libc/include/bits/mbstate_t.h b/libc/include/bits/mbstate_t.h
index 0f9323d1b..b554cffd6 100644
--- a/libc/include/bits/mbstate_t.h
+++ b/libc/include/bits/mbstate_t.h
@@ -35,6 +35,8 @@
 
 #include <sys/cdefs.h>
 
+#ifndef __mbstate_t_defined
+#define __mbstate_t_defined 1
 /**
  * An opaque type used by the multibyte conversion functions.
  * Do not make assumptions about the content of this type.
@@ -45,3 +47,4 @@ typedef struct {
   unsigned char __reserved[4];
 #endif
 } mbstate_t;
+#endif
-- 
2.34.1

