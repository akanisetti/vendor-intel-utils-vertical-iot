+static void add_thousands_comma_to_number(char *in, char *out)
+{
+    int len, left = 0;
+    len = strlen(in);
+    left = len % 3;
+
+    while(len > 0) {
+        *out = *in;
+
+        out++; in++;
+
+        left--;
+        len--;
+
+        if(left == 0 && len >= 3) {
+            *out = ',';
+            out++;
+            left = 3;
+        }
+    }
+    *out='\0';
+}
