From 3845f9f63b56e6fdbf4920dd34df7b4173c53a66 Mon Sep 17 00:00:00 2001
From: Basanagouda Nagappa Koppad <Basanagouda.Nagappa.Koppad@intel.com>
Date: Thu, 23 Jul 2026 09:37:06 +0000
Subject: [PATCH] Fixed build error in boringssl.

Observed build error due to undefined dsa flags.
Adding dummy getentropy function for now.

Tests: Prepared EB, there is no error.

Tracked-On: NA
Signed-off-by: Ankit Agarwal <ankit.agarwal@intel.com>
Signed-off-by: Basanagouda Nagappa Koppad <Basanagouda.Nagappa.Koppad@intel.com>

diff --git a/src/crypto/internal.h b/src/crypto/internal.h
index 1a5ea4b5..af8bcfac 100644
--- a/src/crypto/internal.h
+++ b/src/crypto/internal.h
@@ -184,6 +184,7 @@ static inline int buffers_alias(const void *a, size_t a_bytes, const void *b,
 // power of two, and |ptr| must have at least |alignment - 1| bytes of scratch
 // space.
 static inline void *align_pointer(void *ptr, size_t alignment) {
+  uintptr_t offset;
   // |alignment| must be a power of two.
   assert(alignment != 0 && (alignment & (alignment - 1)) == 0);
   // Instead of aligning |ptr| as a |uintptr_t| and casting back, compute the
@@ -191,7 +192,7 @@ static inline void *align_pointer(void *ptr, size_t alignment) {
   // to |uintptr_t| and back gives the same pointer, but general
   // integer-to-pointer conversions are implementation-defined. GCC does define
   // it in the useful way, but this makes fewer assumptions.
-  uintptr_t offset = (0u - (uintptr_t)ptr) & (alignment - 1);
+  offset = (0u - (uintptr_t)ptr) & (alignment - 1);
   ptr = (char *)ptr + offset;
   assert(((uintptr_t)ptr & (alignment - 1)) == 0);
   return ptr;
@@ -422,9 +423,11 @@ static inline uint32_t constant_time_select_32(crypto_word_t mask, uint32_t a,
 static inline void constant_time_conditional_memcpy(void *dst, const void *src,
                                                     const size_t n,
                                                     const crypto_word_t mask) {
+  uint8_t *out;
+  const uint8_t *in;
   assert(!buffers_alias(dst, n, src, n));
-  uint8_t *out = (uint8_t *)dst;
-  const uint8_t *in = (const uint8_t *)src;
+  out = (uint8_t *)dst;
+  in = (const uint8_t *)src;
   for (size_t i = 0; i < n; i++) {
     out[i] = constant_time_select_8(mask, in[i], out[i]);
   }
@@ -436,9 +439,11 @@ static inline void constant_time_conditional_memcpy(void *dst, const void *src,
 static inline void constant_time_conditional_memxor(void *dst, const void *src,
                                                     size_t n,
                                                     const crypto_word_t mask) {
+  uint8_t *out;
+  const uint8_t *in;
   assert(!buffers_alias(dst, n, src, n));
-  uint8_t *out = (uint8_t *)dst;
-  const uint8_t *in = (const uint8_t *)src;
+  out = (uint8_t *)dst;
+  in = (const uint8_t *)src;
 #if defined(__GNUC__) && !defined(__clang__)
   // gcc 13.2.0 doesn't automatically vectorize this loop regardless of barrier
   typedef uint8_t v32u8 __attribute__((vector_size(32), aligned(1), may_alias));
@@ -957,10 +962,10 @@ static inline crypto_word_t CRYPTO_load_word_be(const void *in) {
   crypto_word_t v;
   OPENSSL_memcpy(&v, in, sizeof(v));
 #if defined(OPENSSL_64_BIT)
-  static_assert(sizeof(v) == 8, "crypto_word_t has unexpected size");
+  assert(sizeof(v) == 8);
   return CRYPTO_bswap8(v);
 #else
-  static_assert(sizeof(v) == 4, "crypto_word_t has unexpected size");
+  assert(sizeof(v) == 4);
   return CRYPTO_bswap4(v);
 #endif
 }
@@ -1071,7 +1076,9 @@ OPENSSL_EXPORT int boringssl_self_test_slhdsa();
 #if defined(BORINGSSL_FIPS_COUNTERS)
 void boringssl_fips_inc_counter(enum fips_counter_t counter);
 #else
-inline void boringssl_fips_inc_counter(enum fips_counter_t counter) {}
+inline void boringssl_fips_inc_counter(enum fips_counter_t counter) {
+    int i = (counter < 0);
+}
 #endif
 
 #if defined(BORINGSSL_FIPS_BREAK_TESTS)
@@ -1080,7 +1087,11 @@ inline int boringssl_fips_break_test(const char *test) {
   return value != nullptr && strcmp(value, test) == 0;
 }
 #else
-inline int boringssl_fips_break_test(const char *test) { return 0; }
+inline int boringssl_fips_break_test(const char *test) {
+  int i = (strcmp("test", test) == 0);
+  return 0;
+}
+
 #endif  // BORINGSSL_FIPS_BREAK_TESTS
 
 
