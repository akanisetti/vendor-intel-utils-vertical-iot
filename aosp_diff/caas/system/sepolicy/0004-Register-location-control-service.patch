   ))
diff --git a/private/platform_app_all.te b/private/platform_app_all.te
index 115e0df17..8766cc527 100644
--- a/private/platform_app_all.te
+++ b/private/platform_app_all.te
@@ -87,6 +87,7 @@ allow platform_app_all system_api_service:service_manager find;
 allow platform_app_all vr_manager_service:service_manager find;
 allow platform_app_all stats_service:service_manager find;
 allow platform_app_all tradeinmode_service:service_manager find;
+allow platform_app_all location_control_service:service_manager find;
 
 # Allow platform apps to log via statsd.
 binder_call(platform_app_all, statsd)
diff --git a/private/service.te b/private/service.te
index 7e738f82c..735882812 100644
--- a/private/service.te
+++ b/private/service.te
@@ -5,6 +5,7 @@ type aoad_service,                   service_manager_type;
 type authentication_policy_service,  app_api_service, system_api_service, system_server_service, service_manager_type;
 
 type casefolding_remover_service,    service_manager_type;
+type location_control_service,       system_server_service, service_manager_type;
 type contextual_mode_service,        app_api_service, system_server_service, service_manager_type;
 type attention_service,              app_api_service, system_server_service, service_manager_type;
 type bg_install_control_service,     system_api_service, system_server_service, service_manager_type;
diff --git a/private/service_contexts b/private/service_contexts
index de000430b..fc263c2ad 100644
--- a/private/service_contexts
+++ b/private/service_contexts
@@ -362,6 +362,7 @@ legacy_permission                         u:object_r:legacy_permission_service:s
 lights                                    u:object_r:light_service:s0
 locale                                    u:object_r:locale_service:s0
 location                                  u:object_r:location_service:s0
+location_control                          u:object_r:location_control_service:s0
 location_time_zone_manager                u:object_r:location_time_zone_manager_service:s0
 lock_settings                             u:object_r:lock_settings_service:s0
 logcat                                    u:object_r:logcat_service:s0
diff --git a/private/system_app.te b/private/system_app.te
index 00a41baaf..afe35f9b7 100644
--- a/private/system_app.te
+++ b/private/system_app.te
@@ -112,6 +112,7 @@ allow system_app {
   -dnsresolver_service
   -dumpstate_service
   -installd_service
+  -location_control_service
   -lpdump_service
   -mdns_service
   -netd_service
@@ -123,6 +124,7 @@ allow system_app {
   -default_android_service
   -virtualization_maintenance_service
 }:service_manager find;
+allow system_app location_control_service:service_manager find;
 # suppress denials for services system_app should not be accessing.
 dontaudit system_app {
   dnsresolver_service
