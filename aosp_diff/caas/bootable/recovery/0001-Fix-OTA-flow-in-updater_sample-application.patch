+    /**
+     * update_engine cannot access shell_data_file paths like /data/local/tmp on user builds.
+     * For local file OTA sources, copy the package to /data/ota_package and use that URL.
+     */
+    private String prepareUpdateUrl(String originalUrl) throws IOException {
+        if (!originalUrl.startsWith("file://")) {
+            return originalUrl;
+        }
+
+        File source = fileForUrl(originalUrl);
+        Path sourcePath = source.toPath();
+        Path otaPackageDir = Paths.get(PackageFiles.OTA_PACKAGE_DIR);
+        ensureDirectory(otaPackageDir);
+        ensureDirectoryReadableByUpdateEngine(otaPackageDir);
+        Path targetPath = otaPackageDir.resolve(sourcePath.getFileName());
+
+        if (!sourcePath.equals(targetPath)) {
+            Log.i(TAG, "Copying OTA package to " + targetPath + " for update_engine access");
+            Files.copy(sourcePath, targetPath, StandardCopyOption.REPLACE_EXISTING);
+        }
+
+        ensureFileReadableByUpdateEngine(targetPath);
+
+        return "file://" + targetPath;
+    }
+
+    private void ensureDirectoryReadableByUpdateEngine(Path dirPath) {
+        try {
+            Set<PosixFilePermission> permissions = PosixFilePermissions.fromString("rwxr-xr-x");
+            Files.setPosixFilePermissions(dirPath, permissions);
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to set POSIX permissions on directory " + dirPath, e);
+            File dir = dirPath.toFile();
+            if (!dir.setReadable(true, false)) {
+                Log.w(TAG, "Failed to set directory readable for all: " + dirPath);
+            }
+            if (!dir.setExecutable(true, false)) {
+                Log.w(TAG, "Failed to set directory searchable for all: " + dirPath);
+            }
+            if (!dir.setWritable(true, true)) {
+                Log.w(TAG, "Failed to set directory writable for owner: " + dirPath);
+            }
+        }
+    }
+
+    private void ensureFileReadableByUpdateEngine(Path filePath) {
+        try {
+            Set<PosixFilePermission> permissions = PosixFilePermissions.fromString("rw-r--r--");
+            Files.setPosixFilePermissions(filePath, permissions);
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to set POSIX permissions on file " + filePath, e);
+            File file = filePath.toFile();
+            if (!file.setReadable(true, false)) {
+                Log.w(TAG, "Failed to set file readable for all: " + filePath);
+            }
+            if (!file.setWritable(true, true)) {
+                Log.w(TAG, "Failed to set file writable for owner: " + filePath);
+            }
+        }
+    }
+
+    private File fileForUrl(String url) {
+        if (!url.startsWith("file://")) {
+            throw new IllegalArgumentException("Expected file:// URL, got " + url);
+        }
+        return new File(url.substring("file://".length()));
     }
 
